{% comment %}
  Section Shopify « Mon Rituel » (application v3).

  Mise en place :
  1. Thème > Modifier le code > assets : ajouter sunsoari-app.js.
  2. Contenu > Fichiers : téléverser les images du dossier img/. Copier l'adresse du dossier
     (https://cdn.shopify.com/s/files/…/files/) dans le réglage « Adresse des images ».
  3. sections : créer « mon-rituel-app.liquid » et coller ce fichier.
  4. Personnaliser : ajouter la section sur la page /pages/mon-rituel.
     Pour la liste de favoris seule (page « Mes favoris », compte client) : choisir « Favoris » dans « Affichage ».

  Comptes : la cliente se connecte avec son compte client Shopify. Son prénom est transmis
  à l'application. Ses favoris et sa routine sont pour l'instant enregistrés sur son appareil ;
  la synchronisation entre appareils est décrite dans le cahier des charges.
{% endcomment %}

<div class="page-width" style="padding-block: {{ section.settings.padding }}px;">
  {%- if section.settings.heading != blank -%}
    <h2 class="h2" style="text-align:center;margin-bottom:24px;">{{ section.settings.heading }}</h2>
  {%- endif -%}
  <div data-sunsoari-rituel
    data-shop="{{ request.origin }}"
    data-contact="{{ section.settings.contact_url | default: '/pages/contact' }}"
    {%- if section.settings.whatsapp != blank %} data-whatsapp="{{ section.settings.whatsapp }}"{% endif %}
    {%- if section.settings.instagram != blank %} data-instagram="{{ section.settings.instagram }}"{% endif %}
    {%- if section.settings.img_base != blank %} data-img-base="{{ section.settings.img_base }}"{% endif %}
    {%- if section.settings.display == 'favoris' %} data-widget="favoris"{% endif %}
    {%- if section.settings.ai_endpoint != blank %} data-ai-endpoint="{{ section.settings.ai_endpoint }}"{% endif %}
    {%- if section.settings.email_endpoint != blank %} data-email-endpoint="{{ section.settings.email_endpoint }}"{% endif %}
    {%- if customer %} data-customer-name="{{ customer.first_name | escape }}"{% endif %}
    data-login-url="{{ routes.account_login_url }}"
    data-register-url="{{ routes.account_register_url }}"></div>
</div>

<script charset="utf-8" src="{{ 'sunsoari-app.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Mon Rituel (application)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre au-dessus de l'application" },
    { "type": "select", "id": "display", "label": "Affichage", "default": "app", "options": [
      { "value": "app", "label": "Application complète" },
      { "value": "favoris", "label": "Favoris seulement (produits, articles, vidéos, posts)" }
    ] },
    { "type": "text", "id": "whatsapp", "label": "Numéro WhatsApp pour le rituel personnalisé", "default": "0781737521" },
    { "type": "text", "id": "instagram", "label": "Compte Instagram (sans @)", "default": "sunsoari" },
    { "type": "text", "id": "img_base", "label": "Adresse des images (dossier Fichiers Shopify)" },
    { "type": "url", "id": "contact_url", "label": "Lien de contact" },
    { "type": "text", "id": "ai_endpoint", "label": "Adresse du serveur IA (Emergent)", "info": "Laisser vide tant que le serveur n'est pas prêt : l'application fonctionne sans IA." },
    { "type": "text", "id": "email_endpoint", "label": "Adresse d'envoi de la routine par e-mail (Emergent)", "info": "Laisser vide tant que le serveur n'est pas prêt." },
    { "type": "range", "id": "padding", "label": "Espacement vertical", "min": 0, "max": 80, "step": 8, "unit": "px", "default": 24 }
  ],
  "presets": [{ "name": "Mon Rituel (application)" }]
}
{% endschema %}
