{% comment %}
  Section Shopify « Mon Rituel Sunsoari ».
  1. Thème > Modifier le code > assets : ajouter sunsoari-rituel.js
  2. sections : créer « mon-rituel.liquid » et coller ce fichier
  3. Personnaliser > ajouter la section « Mon Rituel » sur une page (ex. /pages/mon-rituel)
{% endcomment %}

<div class="page-width" style="padding-block: {{ section.settings.padding }}px;">
  {%- if section.settings.heading != blank -%}
    <h2 class="h2" style="text-align:center;margin-bottom:24px;">{{ section.settings.heading }}</h2>
  {%- endif -%}
  <div data-sunsoari-rituel data-shop="{{ request.origin }}" data-contact="{{ section.settings.contact_url | default: '/pages/contact' }}"></div>
</div>

<script src="{{ 'sunsoari-rituel.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Mon Rituel",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre au-dessus du widget", "default": "Trouve ton rituel de douche" },
    { "type": "url", "id": "contact_url", "label": "Lien de contact" },
    { "type": "range", "id": "padding", "label": "Espacement vertical", "min": 0, "max": 80, "step": 8, "unit": "px", "default": 40 }
  ],
  "presets": [{ "name": "Mon Rituel" }]
}
{% endschema %}
