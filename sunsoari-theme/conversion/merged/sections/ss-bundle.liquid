{%- comment -%}
  Sunsoari · Compose ton rituel (inspiration « Compose ton bundle »)
  - Une ligne par variante (senteur, couleur…), regroupées par onglets (blocs « Catégorie »).
  - Paliers « quantité:remise:CODE » : au clic sur le bouton, les produits sont ajoutés au panier
    puis le code caché du palier atteint est appliqué via /discount/CODE.
  - Les codes doivent exister dans Shopify (Remises) avec le même minimum de produits.
{%- endcomment -%}
{%- assign uid = 'ssb-' | append: section.id -%}
{%- liquid
  assign tiers = section.settings.tiers | split: ','
  assign first_tier = tiers.first | split: ':'
  assign min_qty = first_tier[0] | strip | plus: 0
  assign last_tier = tiers.last | split: ':'
  assign max_qty = last_tier[0] | strip | plus: 0
-%}
<section class="ssb" id="{{ uid }}" data-tiers="{{ section.settings.tiers | escape }}">
  <div class="ssb__hero">
    {%- if section.settings.eyebrow != blank -%}<span class="ss-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2 class="ssb__h">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<div class="ssb__intro">{{ section.settings.text }}</div>{%- endif -%}
  </div>

  <div class="ssb__meter" data-meter>
    <div class="ssb__meter-top">
      <p class="ssb__pct"><strong data-pct>0 %</strong> <span data-pct-label>de remise pour l'instant</span></p>
      <p class="ssb__nexttier" data-nexttier></p>
    </div>
    <div class="ssb__gauge"><span class="ssb__fill" data-fill></span></div>
    <div class="ssb__ticks">
      {%- for t in tiers -%}
        {%- assign p = t | split: ':' -%}
        {%- assign q = p[0] | strip | plus: 0 -%}
        <span style="left:{{ q | times: 100.0 | divided_by: max_qty }}%" data-tick="{{ q }}">-{{ p[1] | strip }} %</span>
      {%- endfor -%}
    </div>
  </div>

  <div class="ssb__tabs" role="tablist" aria-label="Catégories">
    <button type="button" class="is-on" data-tab="all" role="tab" aria-selected="true">Tout</button>
    {%- for block in section.blocks -%}
      <button type="button" data-tab="{{ block.id }}" role="tab" aria-selected="false" {{ block.shopify_attributes }}>{{ block.settings.title }}</button>
    {%- endfor -%}
  </div>

  <div class="ssb__list">
    {%- for block in section.blocks -%}
      {%- assign n_rows = 0 -%}
      {%- for p in block.settings.products -%}{%- for v in p.variants -%}{%- if v.available -%}{%- assign n_rows = n_rows | plus: 1 -%}{%- endif -%}{%- endfor -%}{%- endfor -%}
      <div class="ssb__group" data-group="{{ block.id }}">
        <div class="ssb__group-head"><h3>{{ block.settings.title }}</h3><span>{{ n_rows }} produit{% if n_rows > 1 %}s{% endif %}</span></div>
        {%- for p in block.settings.products -%}
          {%- assign short = p.title | remove: 'Onsha · ' | remove: 'SHIFT · ' | remove: 'Sullab · ' -%}
          {%- for v in p.variants -%}
            {%- unless v.available -%}{%- continue -%}{%- endunless -%}
            {%- liquid
              assign key = v.title | downcase
              assign tone = '#C4D3E4'
              case key
                when 'hinoki', 'hinoki spring'
                  assign tone = '#D8BC94'
                when 'océan', 'ocean', 'aqua blue'
                  assign tone = '#8DB8DE'
                when 'forêt de pin', 'menthe'
                  assign tone = '#9CC7A4'
                when 'fleur de prunier', 'rose', 'cherry blossom', 'patchouli & rose'
                  assign tone = '#EBB3BF'
                when 'lavande'
                  assign tone = '#C2B3DE'
                when 'noir'
                  assign tone = '#9AA3AD'
                when 'bleu ciel'
                  assign tone = '#B5D6EE'
                when 'fruité'
                  assign tone = '#F2C48D'
                when 'découverte'
                  assign tone = '#D9CDEB'
              endcase
              if p.variants.size > 1
                assign line1 = v.title
                assign line2 = short
              else
                assign line1 = short
                assign line2 = p.vendor
              endif
              assign img = v.featured_image | default: p.featured_image
            -%}
            <div class="ssb__row" data-row data-id="{{ v.id }}" data-price="{{ v.price }}" data-max="{% if v.inventory_management == 'shopify' and v.inventory_policy == 'deny' %}{{ v.inventory_quantity }}{% else %}99{% endif %}" style="--tone:{{ tone }}">
              <div class="ssb__thumb">{%- if img -%}{{ img | image_url: width: 200 | image_tag: loading: 'lazy', alt: line1 }}{%- endif -%}</div>
              <div class="ssb__txt">
                <a class="ssb__name" href="{{ v.url }}">{{ line1 }}</a>
                <span class="ssb__sub">{{ line2 }}</span>
              </div>
              <span class="ssb__price">{{ v.price | money }}</span>
              <div class="ssb__ctl">
                <button type="button" class="ssb__minus" data-minus aria-label="Retirer {{ line1 | escape }}">−</button>
                <span class="ssb__q" data-q aria-live="polite">0</span>
                <button type="button" class="ssb__plus" data-plus aria-label="Ajouter {{ line1 | escape }}">+</button>
              </div>
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}
    {%- if section.settings.note != blank -%}<p class="ssb__note">{{ section.settings.note }}</p>{%- endif -%}
  </div>

  <div class="ssb__tray" data-tray>
    <div class="ssb__tray-top">
      <div class="ssb__slots" data-slots>
        {%- for i in (1..max_qty) -%}<span class="ssb__slot"></span>{%- endfor -%}
      </div>
      <div class="ssb__sum"><span class="ssb__was" data-was></span><strong data-now>0,00 €</strong></div>
    </div>
    <button type="button" class="ssb__cta" data-add disabled>Ajoute {{ min_qty }} produits pour commencer</button>
    <p class="ssb__legal">Remise appliquée automatiquement au panier depuis cette page. Non cumulable avec les autres remises.</p>
  </div>
</section>

<style>
#{{ uid }}{--ink:#042850;--mist:#7591AA;--powder:#C4D3E4;--cream:#EEEBE7;--line:#DDD8D0;--white:#FBFAF8;background:var(--cream);padding:28px 0 0;color:#2B3640;}
#{{ uid }} .ssb__hero{text-align:center;padding:0 16px 18px;max-width:640px;margin:0 auto;}
#{{ uid }} .ssb__h{font-size:clamp(28px,6vw,44px);line-height:1.05;color:var(--ink);margin:6px 0 8px;font-weight:600;letter-spacing:-.01em;}
#{{ uid }} .ssb__intro{color:#5A6671;font-size:15px;}
#{{ uid }} .ssb__intro p{margin:0;}
#{{ uid }} .ssb__meter{position:sticky;top:var(--header-height,0px);z-index:6;background:var(--ink);color:#fff;border-radius:22px;margin:0 16px;padding:18px 20px 14px;max-width:1100px;box-sizing:border-box;}
@media(min-width:1132px){#{{ uid }} .ssb__meter{margin:0 auto;}}
#{{ uid }} .ssb__meter-top{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap;}
#{{ uid }} .ssb__pct{margin:0;font-size:14px;opacity:.95;}
#{{ uid }} .ssb__pct strong{font-size:34px;line-height:1;margin-right:6px;}
#{{ uid }} .ssb__nexttier{margin:0;font-size:13px;opacity:.9;}
#{{ uid }} .ssb__gauge{height:10px;border-radius:99px;background:rgba(255,255,255,.18);margin:14px 0 6px;overflow:hidden;}
#{{ uid }} .ssb__fill{display:block;height:100%;width:0;background:var(--powder);border-radius:99px;transition:width .3s;}
#{{ uid }} .ssb__ticks{position:relative;height:18px;font-size:12px;}
#{{ uid }} .ssb__ticks span{position:absolute;transform:translateX(-100%);opacity:.6;white-space:nowrap;transition:opacity .2s;}
#{{ uid }} .ssb__ticks span.is-on{opacity:1;font-weight:700;}
#{{ uid }} .ssb__tabs{display:flex;gap:8px;overflow-x:auto;padding:16px;max-width:1100px;margin:0 auto;scrollbar-width:none;box-sizing:border-box;}
#{{ uid }} .ssb__tabs::-webkit-scrollbar{display:none;}
#{{ uid }} .ssb__tabs button{flex:0 0 auto;border:0;border-radius:99px;padding:11px 18px;font:inherit;font-size:14px;background:var(--white);color:var(--ink);cursor:pointer;}
#{{ uid }} .ssb__tabs button.is-on{background:var(--ink);color:#fff;font-weight:600;}
#{{ uid }} .ssb__list{max-width:1100px;margin:0 auto;padding:0 16px 24px;box-sizing:border-box;}
#{{ uid }} .ssb__group{margin-bottom:18px;}
#{{ uid }} .ssb__group[hidden]{display:none;}
#{{ uid }} .ssb__group-head{display:flex;justify-content:space-between;align-items:baseline;margin:10px 4px 10px;}
#{{ uid }} .ssb__group-head h3{margin:0;font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink);}
#{{ uid }} .ssb__group-head span{font-size:13px;color:#5A6671;}
#{{ uid }} .ssb__row{display:grid;grid-template-columns:64px 1fr auto auto;align-items:center;gap:12px;padding:10px 10px 10px 10px;margin-bottom:10px;border-radius:20px;background:linear-gradient(90deg,var(--tone) 0%,color-mix(in srgb,var(--tone) 35%,#fff) 45%,var(--white) 80%);box-shadow:0 1px 0 rgba(4,40,80,.04);transition:box-shadow .15s;}
#{{ uid }} .ssb__row.is-picked{box-shadow:0 0 0 2px var(--ink) inset;}
#{{ uid }} .ssb__thumb{width:64px;height:64px;border-radius:14px;overflow:hidden;background:#fff;}
#{{ uid }} .ssb__thumb img{width:100%;height:100%;object-fit:cover;display:block;}
#{{ uid }} .ssb__txt{min-width:0;display:flex;flex-direction:column;}
#{{ uid }} .ssb__name{font-weight:700;color:var(--ink);text-decoration:none;font-size:16px;line-height:1.2;}
#{{ uid }} .ssb__sub{font-size:13px;color:#4E6275;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
#{{ uid }} .ssb__price{font-weight:700;color:var(--ink);font-size:15px;white-space:nowrap;}
#{{ uid }} .ssb__ctl{display:flex;align-items:center;gap:6px;}
#{{ uid }} .ssb__ctl button{width:44px;height:44px;border-radius:50%;border:0;background:var(--ink);color:#fff;font-size:22px;line-height:1;cursor:pointer;}
#{{ uid }} .ssb__minus,#{{ uid }} .ssb__q{display:none;}
#{{ uid }} .ssb__row.is-picked .ssb__minus{display:block;background:#fff;color:var(--ink);box-shadow:0 0 0 1px var(--line) inset;width:34px;height:34px;font-size:18px;}
#{{ uid }} .ssb__row.is-picked .ssb__q{display:block;min-width:16px;text-align:center;font-weight:700;color:var(--ink);}
#{{ uid }} .ssb__ctl button:disabled{opacity:.35;cursor:not-allowed;}
#{{ uid }} .ssb__note{font-size:13px;color:#5A6671;text-align:center;margin:8px 0 0;}
#{{ uid }} .ssb__tray{position:sticky;bottom:0;z-index:7;background:#fff;border-radius:24px 24px 0 0;box-shadow:0 -8px 24px rgba(4,40,80,.08);padding:14px 16px 12px;}
#{{ uid }} .ssb__tray>*{max-width:1100px;margin-left:auto;margin-right:auto;}
#{{ uid }} .ssb__tray-top{display:flex;align-items:center;justify-content:space-between;gap:10px;}
#{{ uid }} .ssb__slots{display:flex;gap:5px;flex-wrap:nowrap;overflow:hidden;}
#{{ uid }} .ssb__slot{width:30px;height:30px;border-radius:50%;border:2px dashed #CFC8BE;background:var(--cream);flex:0 0 auto;overflow:hidden;}
#{{ uid }} .ssb__slot.is-full{border:2px solid var(--powder);background:#fff;}
#{{ uid }} .ssb__slot img{width:100%;height:100%;object-fit:cover;display:block;}
@media(min-width:750px){#{{ uid }} .ssb__slot{width:44px;height:44px;}}
#{{ uid }} .ssb__sum{text-align:right;white-space:nowrap;}
#{{ uid }} .ssb__was{display:block;font-size:12px;color:#5A6671;text-decoration:line-through;min-height:14px;}
#{{ uid }} .ssb__sum strong{font-size:22px;color:var(--ink);}
#{{ uid }} .ssb__cta{display:block;width:100%;margin-top:12px;border:0;border-radius:99px;padding:16px;font:inherit;font-size:16px;font-weight:700;background:var(--ink);color:#fff;cursor:pointer;}
#{{ uid }} .ssb__cta:disabled{background:var(--cream);color:#7B8590;cursor:not-allowed;}
#{{ uid }} .ssb__legal{font-size:11px;color:#5A6671;text-align:center;margin:8px auto 0;}
@media(max-width:420px){#{{ uid }} .ssb__row{grid-template-columns:56px 1fr auto;}#{{ uid }} .ssb__thumb{width:56px;height:56px;}#{{ uid }} .ssb__price{grid-column:2;grid-row:2;margin-top:-6px;font-size:14px;}#{{ uid }} .ssb__ctl{grid-column:3;grid-row:1/3;}}
</style>

<script>
(function(){
  var root=document.getElementById('{{ uid }}'); if(!root||root.dataset.ready) return; root.dataset.ready='1';
  var tiers=(root.dataset.tiers||'').split(',').map(function(t){var p=t.split(':');return {q:+p[0],d:+p[1],code:(p[2]||'').trim()};}).filter(function(t){return t.q>0;}).sort(function(a,b){return a.q-b.q;});
  var maxQ=tiers.length?tiers[tiers.length-1].q:1, minQ=tiers.length?tiers[0].q:1;
  var fmt=new Intl.NumberFormat('fr-FR',{style:'currency',currency:'{{ cart.currency.iso_code | default: "EUR" }}'});
  var rows=[].slice.call(root.querySelectorAll('[data-row]'));
  var picks=[]; // ordre d'ajout, pour remplir les ronds
  function q(r){return +r.querySelector('[data-q]').textContent;}
  function setQ(r,v){r.querySelector('[data-q]').textContent=v;r.classList.toggle('is-picked',v>0);r.querySelector('[data-plus]').disabled=v>=+r.dataset.max;}
  function refresh(){
    var n=0,sub=0;rows.forEach(function(r){var k=q(r);n+=k;sub+=k*(+r.dataset.price);});
    var cur=null,next=null;tiers.forEach(function(t){if(n>=t.q)cur=t;else if(!next)next=t;});
    var d=cur?cur.d:0,now=Math.round(sub*(100-d)/100);
    root.querySelector('[data-pct]').textContent=d+' %';
    root.querySelector('[data-pct-label]').textContent=d?'de remise sur ton rituel':"de remise pour l'instant";
    root.querySelector('[data-nexttier]').textContent=next?('Dès '+next.q+' produits : -'+next.d+' %'+(n?' · encore '+(next.q-n):'')):'Remise maximale atteinte';
    root.querySelector('[data-fill]').style.width=Math.min(100,n/maxQ*100)+'%';
    root.querySelectorAll('[data-tick]').forEach(function(s){s.classList.toggle('is-on',cur&&+s.dataset.tick===cur.q);});
    var slots=root.querySelectorAll('.ssb__slot');
    slots.forEach(function(s,i){var r=picks[i];s.classList.toggle('is-full',!!r);var img=r&&r.querySelector('.ssb__thumb img');s.innerHTML=img?'<img src="'+img.currentSrc.replace(/width=\d+/,'width=100')+'" alt="">':'';});
    root.querySelector('[data-was]').textContent=d?fmt.format(sub/100):'';
    root.querySelector('[data-now]').textContent=fmt.format(now/100);
    var btn=root.querySelector('[data-add]');
    if(n<minQ){btn.disabled=true;btn.textContent='Ajoute '+(minQ-n)+' produit'+(minQ-n>1?'s':'')+(n?' de plus':' pour commencer');}
    else{btn.disabled=false;btn.textContent='Ajouter mon rituel · '+fmt.format(now/100);}
  }
  root.addEventListener('click',function(e){
    var tab=e.target.closest('[data-tab]');
    if(tab){root.querySelectorAll('[data-tab]').forEach(function(b){var on=b===tab;b.classList.toggle('is-on',on);b.setAttribute('aria-selected',on);});
      root.querySelectorAll('[data-group]').forEach(function(g){g.hidden=!(tab.dataset.tab==='all'||g.dataset.group===tab.dataset.tab);});return;}
    var b=e.target.closest('[data-plus],[data-minus]');if(!b)return;
    var r=b.closest('[data-row]'),v=q(r);
    if(b.hasAttribute('data-plus')){if(v>=+r.dataset.max)return;setQ(r,v+1);picks.push(r);}
    else if(v>0){setQ(r,v-1);var i=picks.lastIndexOf(r);if(i>-1)picks.splice(i,1);}
    refresh();
  });
  root.querySelector('[data-add]').addEventListener('click',function(){
    var btn=this,list=[],n=0;rows.forEach(function(r){var k=q(r);if(k>0){list.push({id:+r.dataset.id,quantity:k});n+=k;}});
    if(n<minQ)return;var cur=null;tiers.forEach(function(t){if(n>=t.q)cur=t;});
    btn.disabled=true;btn.textContent='Ajout en cours…';
    var base=(window.Shopify&&Shopify.routes&&Shopify.routes.root)||'/';
    fetch(base+'cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:list})})
      .then(function(r){if(!r.ok)throw r;return r.json();})
      .then(function(){window.location.href=cur&&cur.code?base+'discount/'+encodeURIComponent(cur.code)+'?redirect='+encodeURIComponent(base+'cart'):base+'cart';})
      .catch(function(){btn.disabled=false;refresh();alert("Un produit n'a pas pu être ajouté (stock insuffisant ?). Ajuste les quantités et réessaie.");});
  });
  rows.forEach(function(r){setQ(r,0);});
  refresh();
})();
</script>

{% schema %}
{
  "name": "Compose ton rituel",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Compose ton rituel" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "text", "id": "tiers", "label": "Paliers (quantité:remise:CODE)", "default": "3:5:RITUEL5-SNS,5:10:RITUEL10-SNS,7:15:RITUEL15-SNS", "info": "Chaque code doit exister dans Shopify > Remises, avec le même minimum de produits." },
    { "type": "text", "id": "note", "label": "Note sous la liste" }
  ],
  "blocks": [
    { "type": "category", "name": "Catégorie", "settings": [
      { "type": "text", "id": "title", "label": "Nom de l'onglet", "default": "Rituel Home" },
      { "type": "product_list", "id": "products", "label": "Produits", "limit": 12 }
    ] }
  ],
  "presets": [{ "name": "Compose ton rituel" }]
}
{% endschema %}
