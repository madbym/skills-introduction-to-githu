{%- comment -%}
  Free shipping goal (Sunsoari).

  Règles réelles de la boutique :
  - France : livraison offerte dès `minimum_amount` (70 €) si AUCUNE remise ne s'applique
    (la remise automatique « Livraison offerte France dès 70 € » ne se cumule avec rien) ;
    dès 100 € (montant après remises) si une remise ou un code s'applique (tarif d'expédition gratuit ≥ 100 €).
  - Monaco : dès 100 € (tarif d'expédition uniquement).
  - Autres pays : la barre n'est pas affichée (seuils différents, voir la page Livraison).

  `minimum_amount` accepte aussi une liste par devise, ex. "EUR:70".
  Le calcul (devise, taux) est fait dans l'élément FreeShippingGoal (assets/cart.js).
{%- endcomment -%}
{%- liquid
  assign fsg_country = localization.country.iso_code
  assign fsg_show = false
  if fsg_country == 'FR' or fsg_country == 'MC'
    assign fsg_show = true
  endif
  assign fsg_discounted_goal = '100'
-%}
{%- if fsg_show -%}
{%- capture left_to_spend -%}
    <strong data-left-to-spend></strong>
{%- endcapture -%}
<free-shipping-goal
  data-config="{{ minimum_amount | escape }}"
  data-discounted-config="{{ fsg_discounted_goal }}"
  data-country="{{ fsg_country }}"
  data-active-code="{{ cart.currency.iso_code }}"
  data-shop-code="{{ shop.currency }}"
  data-cart-total="{{ cart.total_price }}"
  data-cart-discount="{{ cart.total_discount }}"
  class="free-shipping-goal grid gap-2{% if classes %} {{ classes }}{% endif %} no-js-hidden"
>
  <span class="free-shipping-goal__label free-shipping-goal__label--success">
    {{- 'general.cart.free_shipping.congratulations_html' | t -}}
  </span>
  <span class="free-shipping-goal__label free-shipping-goal__label--default">
    {{- 'general.cart.free_shipping.remaining_html' | t: remaining_amount: left_to_spend -}}
  </span>
  <progress-bar
    class="progress-bar"
  ></progress-bar>
  <span class="free-shipping-goal__note" style="font-size:11px;line-height:1.4;opacity:.75;">
    {%- if fsg_country == 'MC' -%}
      Livraison offerte à Monaco dès 100 € d'achat.
    {%- else -%}
      Livraison offerte en France dès 70 € d'achat sans remise ni code promo. Avec une remise ou un code (dont le code de bienvenue), elle est offerte dès 100 € d'achat, montant calculé après remise.
    {%- endif -%}
  </span>
</free-shipping-goal>
{%- endif -%}
