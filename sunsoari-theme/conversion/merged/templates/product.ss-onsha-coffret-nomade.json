        "container": "fixed",
        "text_alignment": "start",
        "padding_top": 16,
        "padding_bottom": 20
      }
    },
    "main": {
      "type": "main-product",
      "blocks": {
        "ss_badge": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<span class=\"ss-pdp-badge\">Le rituel thermal portable</span>"
          }
        },
        "title": {
          "type": "title",
          "settings": {
            "heading_size": "h1"
          }
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "ss_facts": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"ss-pdp-facts\"><div><b>Contenu</b>Douchette filtrante, lot de 3 filtres sédiments, set découverte Nomade (1 coque de diffusion + 4 capsules thermales)</div><div><b>Senteurs</b>Hinoki, Océan, Forêt de Pin, Fleur de Prunier</div><div><b>Format</b>Compact, à emporter en voyage</div></div>"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_type": "shopify_swatch",
            "swatch_style": "circle",
            "swatch_size": 32,
            "button_style": "normal",
            "size_title": "Size",
            "size_chart_from_page": ""
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_quantity_selector": true,
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": false
          }
        },
        "reassurance": {
          "type": "icon-with-text",
          "settings": {
            "layout": "vertical",
            "title_font": "body",
            "title_size": "text-base",
            "icon_1": "check",
            "heading_1": "<strong>Sélection Sunsoari</strong> : marques choisies avec exigence",
            "icon_2": "truck",
            "heading_2": "<strong>Livraison suivie</strong> en France métropolitaine",
            "icon_3": "check",
            "heading_3": "<strong>Paiement sécurisé</strong> : CB, Apple Pay, PayPal"
          }
        },
        "acc_1": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Composition et principes actifs",
            "heading_size": "h4",
            "icon": "none",
            "content": "<p>Eau thermale soufrée lyophilisée concentrée 4 fois (donnée de la marque), vitamine C, acide hyaluronique, glycérine. Listes INCI complètes sur chaque emballage.</p>",
            "page": "",
            "default_open": false,
            "show_below_product_media": false
          }
        },
        "acc_2": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Durée et entretien",
            "heading_size": "h4",
            "icon": "none",
            "content": "<p>Chaque capsule dure 10 à 15 jours. La housse se lave à l'eau tiède. Rince régulièrement la coque Nomade.</p>",
            "page": "",
            "default_open": false,
            "show_below_product_media": false
          }
        },
        "sticky_atc": {
          "type": "sticky-atc-bar",
          "settings": {
            "visibility": "all",
            "style": "minimalist",
            "container": "full",
            "show_atc_button": true,
            "show_dynamic_checkout_buttons": false,
            "show_quantity": true
          }
        },
        "ss_complements": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'ss-complements', items: \"capsule-vitaminee-shower-filter-sunsoari||4 senteurs thermales au choix;product-onsha-coque-douchette-filtrante||En option : protège et personnalise ta douchette\", title: \"Pour la suite de ton rituel\", note: \"Ton coffret contient tout pour commencer. Les capsules et la housse sont vendues séparément.\" %}"
          }
        }
      },
