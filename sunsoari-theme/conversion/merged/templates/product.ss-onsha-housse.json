      "block_order": [
        "b1",
        "b2"
      ],
      "settings": {
        "layout": "visuals",
        "background": "white",
        "align": "center",
        "eyebrow": "",
        "heading": "Le style Onsha",
        "text": "",
        "columns": 2,
        "columns_mobile": "1",
        "ratio": "1/1",
        "open_first": false
      }
    },
    "ss_steps": {
      "type": "ss-story",
      "blocks": {
        "b1": {
          "type": "step",
          "settings": {
            "text": "<strong>Glisse</strong> la housse sur ta douchette filtrante Onsha."
          }
        },
        "b2": {
          "type": "step",
          "settings": {
            "text": "<strong>Ajuste</strong> pour qu'elle épouse bien la forme."
          }
        },
        "b3": {
          "type": "step",
          "settings": {
            "text": "<strong>Change</strong> de coloris selon les saisons ou ta déco."
          }
        }
      },
      "block_order": [
        "b1",
        "b2",
        "b3"
      ],
      "settings": {
        "layout": "steps",
        "background": "cream",
        "align": "center",
        "eyebrow": "Mode d'emploi",
        "heading": "Comment l'utiliser",
        "text": "",
        "columns": 3,
        "columns_mobile": "1",
        "ratio": "1/1",
        "open_first": false,
        "tip_title": "Les conseils de l'équipe",
        "tip_text": "<p>Tu cherches une petite attention à offrir avec un coffret Onsha ? La housse est le complément parfait : utile, jolie et à petit prix.</p>",
        "image": "shopify://shop_images/onsha-housse-personnalisable-pour-douchette-3837798.jpg"
      }
    },
    "ss_faq": {
      "type": "ss-story",
      "blocks": {
        "b1": {
          "type": "item",
          "settings": {
            "title": "Avec quels produits est-elle compatible ?",
            "text": "<p>Exclusivement avec la douchette filtrante Onsha.</p>",
            "tag": "",
            "link_label": "",
            "show_price": true
          }
        },
        "b2": {
          "type": "item",
          "settings": {
            "title": "Comment l'entretenir ?",
            "text": "<p>Un simple lavage à l'eau tiède suffit.</p>",
            "tag": "",
            "link_label": "",
            "show_price": true
          }
        },
        "b3": {
          "type": "item",
          "settings": {
            "title": "Gêne-t-elle l'utilisation ?",
            "text": "<p>Non, elle ne gêne ni la prise en main, ni le jet, ni le changement de filtre.</p>",
            "tag": "",
            "link_label": "",
            "show_price": true
          }
        }
      },
      "block_order": [
        "b1",
        "b2",
        "b3"
      ],
      "settings": {
        "layout": "faq",
        "background": "white",
        "align": "center",
        "eyebrow": "On répond à tes questions",
