{
  "sections": {
    "breadcrumbs": {
      "type": "breadcrumbs",
      "settings": {
        "container": "fixed",
        "text_alignment": "start",
        "padding_top": 16,
        "padding_bottom": 20
      }
    },
    "main": {
      "type": "main-product",
      "blocks": {
        "ss_badge": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<span class=\"ss-pdp-badge\">L&#x27;accessoire à ton image</span>"
          }
        },
        "title": {
          "type": "title",
          "settings": {
            "heading_size": "h1"
          }
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "ss_facts": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"ss-pdp-facts\"><div><b>Compatibilité</b>Exclusivement la douchette filtrante Onsha</div><div><b>Matière</b>Silicone souple et résistant, sans BPA selon le fabricant</div><div><b>Entretien</b>Lavable à l&#x27;eau tiède</div></div>"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_type": "shopify_swatch",
            "swatch_style": "circle",
            "swatch_size": 32,
            "button_style": "normal",
            "size_title": "Size",
            "size_chart_from_page": ""
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_quantity_selector": true,
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": false
          }
        },
        "reassurance": {
          "type": "icon-with-text",
          "settings": {
            "layout": "vertical",
            "title_font": "body",
            "title_size": "text-base",
            "icon_1": "check",
            "heading_1": "<strong>Sélection Sunsoari</strong> : marques choisies avec exigence",
            "icon_2": "truck",
            "heading_2": "<strong>Livraison suivie</strong> en France métropolitaine",
            "icon_3": "check",
            "heading_3": "<strong>Paiement sécurisé</strong> : CB, Apple Pay, PayPal"
          }
        },
        "acc_1": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Caractéristiques et matière",
            "heading_size": "h4",
            "icon": "none",
            "content": "<p>Silicone souple et résistant, sans BPA selon le fabricant. Compatible exclusivement avec la douchette filtrante Onsha. Lavable à l'eau tiède. Tenir les petits éléments hors de portée des enfants.</p>",
            "page": "",
            "default_open": false,
            "show_below_product_media": false
          }
        },
        "sticky_atc": {
          "type": "sticky-atc-bar",
          "settings": {
            "visibility": "all",
            "style": "minimalist",
            "container": "full",
            "show_atc_button": true,
            "show_dynamic_checkout_buttons": false,
            "show_quantity": true
          }
        },
        "ss_complements": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'ss-complements', items: \"douchette-filtrante||Filtre sédiment inclus\", title: \"La housse est vendue seule\", note: \"Elle s'adapte uniquement à la douchette filtrante Onsha.\" %}"
          }
        },
        "ss_rating": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'ss-rating', product: product %}"
          }
        }
      },
      "block_order": [
        "ss_badge",
        "title",
        "ss_rating",
        "price",
        "description",
        "variant_picker",
        "buy_buttons",
        "ss_complements",
        "ss_facts",
        "reassurance",
        "acc_1",
        "sticky_atc"
      ],
      "custom_css": [
        "@media (min-width: 1280px) {.product {padding-inline: 5rem; }}"
      ],
      "settings": {
        "color_scheme": "scheme-1",
        "use_color_scheme_in_container": false,
        "enable_sticky_info": true,
        "media_size": "large",
        "gallery_layout": "vertical-carousel",
        "mobile_thumbnails": "show",
        "show_image_border": false,
        "enable_image_zoom": true,
        "enable_video_looping": true,
        "padding_top": 0,
        "padding_bottom": 40
      }
    },
    "ss_visuals": {
      "type": "ss-story",
      "blocks": {
        "b1": {
          "type": "item",
          "settings": {
            "title": "Six coloris à associer",
            "text": "",
            "tag": "",
            "link_label": "",
            "show_price": true,
            "image": "shopify://shop_images/onsha-housse-personnalisable-pour-douchette-2337251.jpg"
          }
        },
        "b2": {
          "type": "item",
          "settings": {
            "title": "Housse installée sur la douchette",
            "text": "",
            "tag": "",
            "link_label": "",
            "show_price": true,
            "image": "shopify://shop_images/onsha-housse-personnalisable-pour-douchette-7891355.jpg"
