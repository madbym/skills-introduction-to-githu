{
  "sections": {
    "breadcrumbs": {
      "type": "breadcrumbs",
      "settings": {
        "container": "fixed",
        "text_alignment": "start",
        "padding_top": 16,
        "padding_bottom": 20
      }
    },
    "main": {
      "type": "main-product",
      "blocks": {
        "ss_badge": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<span class=\"ss-pdp-badge\">La recharge essentielle</span>"
          }
        },
        "title": {
          "type": "title",
          "settings": {
            "heading_size": "h1"
          }
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "ss_facts": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"ss-pdp-facts\"><div><b>Rôle</b>Filtration mécanique qui retient les sédiments et particules visibles</div><div><b>Compatibilité</b>Douchette filtrante Onsha uniquement</div><div><b>Durée d&#x27;utilisation</b>4 à 6 semaines selon ton eau et ta fréquence de douche</div></div>"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_type": "shopify_swatch",
            "swatch_style": "circle",
            "swatch_size": 32,
            "button_style": "normal",
            "size_title": "Size",
            "size_chart_from_page": ""
          }
        },
        "ss_offers": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'ss-offers', product: product, section_id: section.id, tiers: '1:0,2:5,4:10', singular: \"filtre\", plural: \"filtres\", title: \"Choisis ta quantité\" %}"
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_quantity_selector": true,
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": false
          }
        },
        "reassurance": {
          "type": "icon-with-text",
          "settings": {
            "layout": "vertical",
            "title_font": "body",
            "title_size": "text-base",
            "icon_1": "check",
            "heading_1": "<strong>Sélection Sunsoari</strong> : marques choisies avec exigence",
            "icon_2": "truck",
            "heading_2": "<strong>Livraison suivie</strong> en France métropolitaine",
            "icon_3": "check",
            "heading_3": "<strong>Paiement sécurisé</strong> : CB, Apple Pay, PayPal"
          }
        },
        "acc_1": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Composition",
            "heading_size": "h4",
            "icon": "none",
            "content": "<p>Filtration mécanique multi-couches. Usage externe uniquement, dans la douchette Onsha. L'eau filtrée n'est pas destinée à la consommation. Conçu en Corée.</p>",
            "page": "",
            "default_open": false,
            "show_below_product_media": false
          }
        },
        "sticky_atc": {
          "type": "sticky-atc-bar",
          "settings": {
            "visibility": "all",
            "style": "minimalist",
            "container": "full",
            "show_atc_button": true,
            "show_dynamic_checkout_buttons": false,
            "show_quantity": true
          }
        },
        "ss_complements": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'ss-complements', items: \"douchette-filtrante||Filtre sédiment inclus à l'achat\", title: \"Pour la douchette filtrante Onsha\", note: \"Cette recharge s'utilise uniquement dans la douchette filtrante Onsha, vendue séparément.\" %}"
          }
        }
      },
      "block_order": [
        "ss_badge",
        "title",
        "price",
        "description",
        "variant_picker",
        "ss_offers",
        "buy_buttons",
        "ss_complements",
        "ss_facts",
        "reassurance",
        "acc_1",
        "sticky_atc"
      ],
      "custom_css": [
        "@media (min-width: 1280px) {.product {padding-inline: 5rem; }}"
      ],
      "settings": {
        "color_scheme": "scheme-1",
        "use_color_scheme_in_container": false,
        "enable_sticky_info": true,
        "media_size": "large",
        "gallery_layout": "vertical-carousel",
        "mobile_thumbnails": "show",
        "show_image_border": false,
        "enable_image_zoom": true,
        "enable_video_looping": true,
        "padding_top": 0,
        "padding_bottom": 40
      }
    },
    "ss_visuals": {
      "type": "ss-story",
      "blocks": {
        "b1": {
          "type": "item",
          "settings": {
            "title": "Le filtre se glisse dans le manche",
            "text": "",
            "tag": "",
            "link_label": "",
            "show_price": true,
            "image": "shopify://shop_images/onsha-douchette-filtrante-vue-eclatee-filtre.jpg"
          }
        },
        "b2": {
          "type": "item",
          "settings": {
            "title": "Un filtre au cœur de la douchette",
            "text": "",
            "tag": "",
            "link_label": "",
            "show_price": true,
            "image": "shopify://shop_images/onsha-douchette-filtrante-filtre-interne.jpg"
          }
        }
      },
      "block_order": [
        "b1",
        "b2"
      ],
      "settings": {
        "layout": "visuals",
        "background": "white",
        "align": "center",
        "eyebrow": "",
        "heading": "Où se place le filtre",
        "text": "",
        "columns": 2,
        "columns_mobile": "1",
        "ratio": "1/1",
        "open_first": false
      }
    },
    "ss_steps": {
      "type": "ss-story",
      "blocks": {
        "b1": {
          "type": "step",
          "settings": {
            "text": "<strong>Ouvre</strong> le compartiment de ta douchette Onsha."
          }
        },
        "b2": {
          "type": "step",
          "settings": {
            "text": "<strong>Retire</strong> le filtre usagé."
          }
        },
        "b3": {
          "type": "step",
          "settings": {
            "text": "<strong>Insère</strong> le nouveau filtre."
          }
        },
        "b4": {
          "type": "step",
          "settings": {
            "text": "<strong>Referme</strong> : ton rituel reprend immédiatement."
          }
        }
      },
      "block_order": [
        "b1",
        "b2",
        "b3",
        "b4"
      ],
      "settings": {
        "layout": "steps",
        "background": "cream",
        "align": "center",
        "eyebrow": "Mode d'emploi",
        "heading": "Remplace ton filtre",
        "text": "",
        "columns": 3,
        "columns_mobile": "1",
        "ratio": "1/1",
        "open_first": false,
        "tip_title": "Les conseils de l'équipe",
        "tip_text": "<p>Garde toujours une recharge d'avance dans ta trousse. Si tu vois le filtre changer de couleur, c'est le signal qu'il a bien travaillé.</p>",
        "image": "shopify://shop_images/onsha-filtre-sediment-recharge-9248658.jpg"
      }
    },
    "ss_faq": {
      "type": "ss-story",
      "blocks": {
        "b2": {
          "type": "item",
          "settings": {
            "title": "Pourquoi le filtre change-t-il de couleur ?",
            "text": "<p>Parce qu'il retient les sédiments et particules de l'eau. C'est le signe que la filtration fonctionne.</p>",
            "tag": "",
            "link_label": "",
            "show_price": true
          }
        }
      },
      "block_order": [
        "b2"
      ],
      "settings": {
        "layout": "faq",
        "background": "white",
        "align": "center",
        "eyebrow": "On répond à tes questions",
        "heading": "Questions fréquentes",
        "text": "",
        "columns": 3,
        "columns_mobile": "1",
        "ratio": "1/1",
        "open_first": true
      }
    }
  },
  "order": [
    "breadcrumbs",
    "main",
    "ss_visuals",
    "ss_steps",
    "ss_faq"
  ]
}
