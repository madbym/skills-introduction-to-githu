          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"ss-pdp-facts\"><div><b>Contenu</b>1 coque de diffusion Home + 4 filtres thermaux vitaminés (1 par senteur)</div><div><b>À associer</b>Au pommeau de douche filtrant Onsha pour le système complet</div><div><b>Durée</b>3 à 4 mois de rituel avec les 4 filtres</div></div>"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
