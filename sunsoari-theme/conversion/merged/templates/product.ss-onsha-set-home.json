            "icon_2": "truck",
            "heading_2": "<strong>Livraison suivie</strong> en France métropolitaine",
            "icon_3": "check",
            "heading_3": "<strong>Paiement sécurisé</strong> : CB, Apple Pay, PayPal"
          }
        },
        "acc_1": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Composition et sécurité",
            "heading_size": "h4",
            "icon": "none",
            "content": "<p><strong>Coque de diffusion Home :</strong> polypropylène (PP) et silicone, sans BPA selon le fabricant. Compatible flexibles standard.</p><p><strong>Filtres thermaux vitaminés :</strong> eau thermale soufrée lyophilisée concentrée 4 fois (donnée de la marque), vitamine C, acide hyaluronique, glycérine, MSM et senteur. Listes INCI complètes sur chaque emballage.</p><p>Usage externe uniquement. Tenir hors de portée des enfants.</p>",
            "page": "",
            "default_open": false,
            "show_below_product_media": false
          }
        },
        "sticky_atc": {
          "type": "sticky-atc-bar",
          "settings": {
            "visibility": "all",
            "style": "minimalist",
            "container": "full",
            "show_atc_button": true,
            "show_dynamic_checkout_buttons": false,
            "show_quantity": true
          }
        },
        "ss_complements": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'ss-complements', items: \"pommeau-de-douche-filtrant||Le jet fin du rituel Home\", title: \"Envie du jet fin Onsha ?\", note: \"Ton set contient la coque et 4 filtres. La coque se visse sur la plupart des pommeaux de douche à raccord standard, ou sur le pommeau de douche filtrant Onsha :\" %}"
          }
        }
