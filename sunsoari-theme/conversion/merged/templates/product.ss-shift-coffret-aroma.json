        "ss_facts": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"ss-pdp-facts\"><div><b>Contenu</b>Pommeau de douche, flexible silicone 2 m, 3 filtres Pure Water, 6 capsules soin</div><div><b>Autonomie</b>Environ 3 mois de capsules, 6 à 9 mois de filtres</div><div><b>Couleur</b>Choisis la couleur de ton pommeau de douche</div></div>"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_type": "shopify_swatch",
            "swatch_style": "circle",
            "swatch_size": 32,
            "button_style": "normal",
            "size_title": "Size",
            "size_chart_from_page": ""
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_quantity_selector": true,
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": false
