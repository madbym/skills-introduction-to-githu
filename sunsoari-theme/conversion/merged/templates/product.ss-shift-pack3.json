{
  "sections": {
    "breadcrumbs": {
      "type": "breadcrumbs",
      "settings": {
        "container": "fixed",
        "text_alignment": "start",
        "padding_top": 16,
        "padding_bottom": 20
      }
    },
    "main": {
      "type": "main-product",
      "blocks": {
        "ss_badge": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<span class=\"ss-pdp-badge\">Les recharges techniques</span>"
          }
        },
        "title": {
          "type": "title",
          "settings": {
            "heading_size": "h1"
          }
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "ss_facts": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"ss-pdp-facts\"><div><b>Rôle</b>Filtration mécanique multi-couches des sédiments et particules visibles</div><div><b>Compatibilité</b>Pommeau de douche filtrant SHIFT uniquement</div><div><b>Durée</b>2 à 3 mois par filtre selon ton eau</div></div>"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_type": "shopify_swatch",
            "swatch_style": "circle",
            "swatch_size": 32,
            "button_style": "normal",
            "size_title": "Size",
            "size_chart_from_page": ""
          }
        },
        "ss_offers": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'ss-offers', product: product, section_id: section.id, tiers: '1:0,2:5', singular: \"pack\", plural: \"packs\", title: \"Choisis ta quantité\" %}"
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_quantity_selector": true,
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": false
          }
        },
        "reassurance": {
          "type": "icon-with-text",
          "settings": {
            "layout": "vertical",
            "title_font": "body",
            "title_size": "text-base",
            "icon_1": "check",
            "heading_1": "<strong>Sélection Sunsoari</strong> : marques choisies avec exigence",
            "icon_2": "truck",
            "heading_2": "<strong>Livraison suivie</strong> en France métropolitaine",
            "icon_3": "check",
            "heading_3": "<strong>Paiement sécurisé</strong> : CB, Apple Pay, PayPal"
          }
        },
        "acc_1": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Composition",
            "heading_size": "h4",
            "icon": "none",
            "content": "<p>Filtration mécanique multi-couches. Usage externe uniquement. Le filtre à sédiments Pure Water est distinct de la capsule de soin : les deux travaillent ensemble.</p>",
            "page": "",
            "default_open": false,
            "show_below_product_media": false
          }
        },
        "sticky_atc": {
          "type": "sticky-atc-bar",
          "settings": {
            "visibility": "all",
            "style": "minimalist",
            "container": "full",
            "show_atc_button": true,
            "show_dynamic_checkout_buttons": false,
            "show_quantity": true
          }
        },
        "ss_complements": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'ss-complements', items: \"pommeau-de-douche-filtrant-a-vitamine-c-aromatherapie||Pommeau de douche, capsule et filtre pour commencer;pack-6-capsules-vitaminees-shift-sunsoari||Les capsules soin et aromathérapie\", title: \"Les filtres sont vendus seuls\", note: \"Ils s'utilisent uniquement dans le pommeau de douche filtrant SHIFT. Pas encore équipée ?\" %}"
          }
        }
      },
      "block_order": [
        "ss_badge",
        "title",
        "price",
        "description",
        "variant_picker",
        "ss_offers",
        "buy_buttons",
        "ss_complements",
        "ss_facts",
        "reassurance",
        "acc_1",
        "sticky_atc"
      ],
      "custom_css": [
        "@media (min-width: 1280px) {.product {padding-inline: 5rem; }}"
      ],
      "settings": {
        "color_scheme": "scheme-1",
        "use_color_scheme_in_container": false,
        "enable_sticky_info": true,
        "media_size": "large",
        "gallery_layout": "vertical-carousel",
        "mobile_thumbnails": "show",
        "show_image_border": false,
        "enable_image_zoom": true,
        "enable_video_looping": true,
        "padding_top": 0,
        "padding_bottom": 40
      }
    },
    "ss_visuals": {
      "type": "ss-story",
      "blocks": {
        "b1": {
          "type": "item",
          "settings": {
            "title": "1. Ouvre le manche et retire le filtre usagé",
            "text": "",
            "tag": "",
            "link_label": "",
            "show_price": true,
            "image": "shopify://shop_images/shift-filtre-pure-water-retrait-pomme-de-douche.jpg"
          }
        },
        "b2": {
          "type": "item",
          "settings": {
            "title": "2. Glisse le nouveau filtre et referme",
            "text": "",
            "tag": "",
            "link_label": "",
            "show_price": true,
            "image": "shopify://shop_images/shift-filtre-pure-water-insertion-pomme-de-douche.jpg"
          }
        }
      },
      "block_order": [
        "b1",
        "b2"
      ],
      "settings": {
        "layout": "visuals",
        "background": "white",
        "align": "center",
        "eyebrow": "Mode d'emploi",
        "heading": "Remplace ton filtre en 2 gestes",
        "text": "",
        "columns": 2,
        "columns_mobile": "1",
        "ratio": "1/1",
        "open_first": false
      }
    },
    "ss_steps": {
      "type": "ss-story",
      "blocks": {
        "b1": {
          "type": "step",
          "settings": {
            "text": "<strong>Ouvre</strong> le compartiment du pommeau de douche SHIFT."
          }
        },
        "b2": {
          "type": "step",
          "settings": {
            "text": "<strong>Retire</strong> le filtre usagé."
          }
        },
        "b3": {
          "type": "step",
          "settings": {
            "text": "<strong>Insère</strong> un nouveau filtre à sédiments Pure Water."
          }
        },
        "b4": {
          "type": "step",
          "settings": {
            "text": "<strong>Referme</strong> : c'est reparti."
          }
        }
      },
      "block_order": [
        "b1",
        "b2",
        "b3",
        "b4"
      ],
      "settings": {
        "layout": "steps",
        "background": "cream",
        "align": "center",
        "eyebrow": "Mode d'emploi",
        "heading": "Le détail, étape par étape",
        "text": "",
        "columns": 3,
        "columns_mobile": "1",
        "ratio": "1/1",
        "open_first": false,
        "tip_title": "Les conseils de l'équipe",
        "tip_text": "",
        "image": "shopify://shop_images/shift-pomme-de-douche-filtrante-packshot.jpg"
      }
    },
    "ss_faq": {
      "type": "ss-story",
      "blocks": {
        "b1": {
          "type": "item",
          "settings": {
            "title": "Les filtres remplacent-ils les capsules ?",
            "text": "<p>Non. Le filtre retient les sédiments, la capsule apporte le soin et la senteur. Ils travaillent ensemble.</p>",
            "tag": "",
            "link_label": "",
            "show_price": true
          }
        },
        "b2": {
          "type": "item",
          "settings": {
            "title": "Puis-je les stocker longtemps ?",
            "text": "<p>Oui, au sec, dans leur emballage d'origine, à température ambiante.</p>",
            "tag": "",
            "link_label": "",
            "show_price": true
          }
        }
      },
      "block_order": [
        "b1",
        "b2"
      ],
      "settings": {
        "layout": "faq",
        "background": "white",
        "align": "center",
        "eyebrow": "On répond à tes questions",
        "heading": "Questions fréquentes",
        "text": "",
        "columns": 3,
        "columns_mobile": "1",
        "ratio": "1/1",
        "open_first": true
      }
    }
  },
  "order": [
    "breadcrumbs",
    "main",
    "ss_visuals",
    "ss_steps",
    "ss_faq"
  ]
}
