{%- liquid
  assign s = section.settings
-%}
<section class="ss-sec ss-sec--{{ s.background }}" id="ss-{{ section.id }}">
  <div class="ss-wrap">
    <div class="ss-it ss-it--{{ s.image_position }}">
      <div class="ss-it__media">
        {%- if s.image != blank -%}{{ s.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', alt: s.heading }}{%- endif -%}
      </div>
      <div class="ss-it__content">
        {%- if s.eyebrow != blank -%}<span class="ss-eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="ss-h2">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="ss-lead">{{ s.text }}</div>{%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <ul class="ss-checks" style="margin-top:16px">
            {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}><span>{{ block.settings.text }}</span></li>{%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if s.button_label != blank -%}<p style="margin:22px 0 0"><a class="btn btn--primary" href="{{ s.button_link }}">{{ s.button_label }}</a></p>{%- endif -%}
      </div>
    </div>
  </div>
</section>
<style>
#ss-{{ section.id }} .ss-it{display:grid;gap:20px;align-items:center;}
@media(min-width:750px){#ss-{{ section.id }} .ss-it{grid-template-columns:1fr 1fr;gap:48px;}#ss-{{ section.id }} .ss-it--right .ss-it__media{order:2;}}
#ss-{{ section.id }} .ss-it__media{border-radius:var(--ss-radius);overflow:hidden;background:var(--ss-cream);aspect-ratio:{{ s.ratio }};border:1px solid var(--ss-line);}
#ss-{{ section.id }} .ss-it__media img{width:100%;height:100%;object-fit:cover;display:block;}
</style>
{% schema %}
{
  "name": "Sunsoari · Image et texte",
  "tag": "div",
  "settings": [
    { "type": "select", "id": "background", "label": "Fond", "default": "white", "options": [
      { "value": "white", "label": "Blanc" }, { "value": "cream", "label": "Crème" }, { "value": "sand", "label": "Sable" }, { "value": "powder", "label": "Bleu brume" }, { "value": "indigo", "label": "Indigo" }
    ]},
    { "type": "select", "id": "image_position", "label": "Image", "default": "left", "options": [{ "value": "left", "label": "À gauche" }, { "value": "right", "label": "À droite" }] },
    { "type": "select", "id": "ratio", "label": "Format", "default": "4/5", "options": [{ "value": "1/1", "label": "Carré" }, { "value": "4/5", "label": "Portrait" }, { "value": "16/10", "label": "Paysage" }] },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "text", "id": "heading", "label": "Titre" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "text", "id": "button_label", "label": "Bouton" },
    { "type": "url", "id": "button_link", "label": "Lien" }
  ],
  "blocks": [{ "type": "point", "name": "Point clé", "settings": [{ "type": "inline_richtext", "id": "text", "label": "Texte" }] }],
  "presets": [{ "name": "Sunsoari · Image et texte" }]
}
{% endschema %}
