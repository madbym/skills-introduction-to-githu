    "main": {
      "type": "main-product",
      "blocks": {
        "ss_badge": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<span class=\"ss-pdp-badge\">Le rituel complet et durable</span>"
          }
        },
        "title": {
          "type": "title",
          "settings": {
            "heading_size": "h1"
          }
        },
        "ss_pills": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"ss-pdp-pills\"><span>Pommeau + coque + 4 filtres</span><span>3 à 4 mois de soin</span><span>Installation sans outil</span></div>"
          }
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "ss_facts": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"ss-pdp-facts\"><div><b>Contenu</b>Pommeau filtrant, coque de diffusion Home, 4 filtres thermaux vitaminés</div><div><b>Autonomie</b>3 à 4 mois avec les 4 filtres</div><div><b>Senteurs</b>Hinoki, Océan, Forêt de Pin, Fleur de Prunier</div></div>"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_type": "shopify_swatch",
            "swatch_style": "circle",
            "swatch_size": 32,
            "button_style": "normal",
            "size_title": "Size",
            "size_chart_from_page": ""
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_quantity_selector": true,
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": false
          }
        },
        "ss_checks": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<ul class=\"ss-checks\"><li><span>Système complet : <strong>tu installes et tu commences</strong></span></li><li><span><strong>4 senteurs thermales coréennes</strong> incluses</span></li><li><span>S'installe <strong>en deux minutes</strong>, sans outil</span></li></ul>"
          }
        },
        "reassurance": {
          "type": "icon-with-text",
          "settings": {
            "layout": "vertical",
            "title_font": "body",
            "title_size": "text-base",
            "icon_1": "check",
            "heading_1": "<strong>Sélection Sunsoari</strong> : marques choisies avec exigence",
            "icon_2": "truck",
            "heading_2": "<strong>Livraison suivie</strong> en France métropolitaine",
            "icon_3": "check",
            "heading_3": "<strong>Paiement sécurisé</strong> : CB, Apple Pay, PayPal"
          }
        },
        "acc_1": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Composition et principes actifs",
            "heading_size": "h4",
            "icon": "none",
            "content": "<p>Eau thermale soufrée extraite à 808 m dans le granit coréen, lyophilisée et concentrée 4 fois (données de la marque). Actifs de soin : vitamine C, acide hyaluronique, glycérine, MSM. Listes INCI complètes sur chaque emballage.</p>",
            "page": "",
            "default_open": false,
            "show_below_product_media": false
          }
        },
        "acc_2": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Durée et entretien",
            "heading_size": "h4",
            "icon": "none",
            "content": "<p>Chaque filtre dure 3 à 4 semaines, soit 3 à 4 mois avec les 4 filtres. Rince régulièrement la coque de diffusion.</p>",
            "page": "",
            "default_open": false,
            "show_below_product_media": false
          }
        },
        "sticky_atc": {
          "type": "sticky-atc-bar",
          "settings": {
            "visibility": "all",
            "style": "minimalist",
            "container": "full",
            "show_atc_button": true,
            "show_dynamic_checkout_buttons": false,
            "show_quantity": true
          }
        },
        "ss_addon_1": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'ss-addon', addon: all_products['filtre-vitamine-showerfilter-sunsoari'], variant_title: \"\", kind: 'complement', title: \"Prends de l'avance sur tes recharges :\", note: \"Un filtre thermal en plus, senteur au choix.\", section_id: section.id %}"
          }
        },
        "ss_addon_2": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'ss-addon', addon: all_products['onsha-filtre-thermal-vitamine-sans-senteur'], variant_title: \"1 filtre\", kind: 'choix', title: \"\", note: \"Ou la version sans senteur.\", section_id: section.id %}"
          }
        }
      },
