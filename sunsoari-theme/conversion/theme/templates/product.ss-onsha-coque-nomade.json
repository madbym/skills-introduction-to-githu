            "layout": "vertical",
            "title_font": "body",
            "title_size": "text-base",
            "icon_1": "check",
            "heading_1": "<strong>Sélection Sunsoari</strong> : marques choisies avec exigence",
            "icon_2": "truck",
            "heading_2": "<strong>Livraison suivie</strong> en France métropolitaine",
            "icon_3": "check",
            "heading_3": "<strong>Paiement sécurisé</strong> : CB, Apple Pay, PayPal"
          }
        },
        "acc_1": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Caractéristiques et matériaux",
            "heading_size": "h4",
            "icon": "none",
            "content": "<p>Polypropylène (PP) et silicone, sans BPA selon le fabricant.</p><p><strong>Attention :</strong> la coque Nomade accueille les capsules thermales Nomade. Les filtres Home se glissent dans la coque Home (Grand format) : les deux formats ne sont pas interchangeables.</p><p>Usage domestique uniquement. Ne pas forcer le vissage.</p>",
            "page": "",
            "default_open": false,
            "show_below_product_media": false
          }
        },
        "sticky_atc": {
          "type": "sticky-atc-bar",
          "settings": {
            "visibility": "all",
            "style": "minimalist",
            "container": "full",
            "show_atc_button": true,
            "show_dynamic_checkout_buttons": false,
            "show_quantity": true
          }
        },
        "ss_addon_1": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'ss-addon', addon: all_products['capsule-vitaminee-shower-filter-sunsoari'], variant_title: \"\", kind: 'indispensable', title: \"Ta coque a besoin de sa capsule :\", note: \"La capsule thermale qui se glisse dans la coque. Senteur au choix.\", section_id: section.id %}"
          }
        },
        "ss_addon_2": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'ss-addon', addon: all_products['douchette-filtrante'], variant_title: \"\", kind: 'complement', title: \"\", note: \"La douchette filtrante sur laquelle se fixe la coque.\", section_id: section.id %}"
          }
