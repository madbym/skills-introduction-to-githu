          }
        },
        "acc_1": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Caractéristiques et matériaux",
            "heading_size": "h4",
            "icon": "none",
            "content": "<p>Polypropylène (PP) et silicone, sans BPA selon le fabricant. Compatible avec les flexibles de douche standard.</p><p><strong>Attention :</strong> les deux formats ne sont pas interchangeables. Le Grand format accueille les filtres Home, le Mini format accueille les capsules Nomade.</p><p>Usage domestique uniquement. Ne pas forcer le vissage.</p>",
            "page": "",
            "default_open": false,
            "show_below_product_media": false
          }
        },
        "sticky_atc": {
          "type": "sticky-atc-bar",
          "settings": {
            "visibility": "all",
            "style": "minimalist",
            "container": "full",
            "show_atc_button": true,
            "show_dynamic_checkout_buttons": false,
            "show_quantity": true
          }
        },
        "ss_addon_1": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'ss-addon', addon: all_products['filtre-vitamine-showerfilter-sunsoari'], variant_title: \"\", kind: 'indispensable', title: \"Ta coque a besoin de son filtre :\", note: \"Le filtre thermal qui se glisse dans la coque. Senteur au choix.\", section_id: section.id %}"
          }
        },
        "ss_addon_2": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'ss-addon', addon: all_products['onsha-filtre-thermal-vitamine-sans-senteur'], variant_title: \"1 filtre\", kind: 'choix', title: \"\", note: \"Tu préfères sans parfum ? La même base de soin, sans senteur ajoutée.\", section_id: section.id %}"
          }
