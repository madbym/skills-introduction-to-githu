          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'ss-addon', addon: all_products['douchette-filtrante'], variant_title: \"\", kind: 'indispensable', title: \"\", note: \"Pas encore la douchette sur laquelle s'adapte ta housse ?\", section_id: section.id %}"
