          "type": "collapsible_tab",
          "settings": {
            "heading": "Caractéristiques et matière",
            "heading_size": "h4",
            "icon": "none",
            "content": "<p>Silicone souple et résistant, sans BPA selon le fabricant. Compatible exclusivement avec la douchette filtrante Onsha. Lavable à l'eau tiède. Tenir les petits éléments hors de portée des enfants.</p>",
            "page": "",
            "default_open": false,
            "show_below_product_media": false
          }
        },
        "sticky_atc": {
          "type": "sticky-atc-bar",
          "settings": {
            "visibility": "all",
            "style": "minimalist",
            "container": "full",
            "show_atc_button": true,
            "show_dynamic_checkout_buttons": false,
            "show_quantity": true
          }
        },
