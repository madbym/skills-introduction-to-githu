        "title": {
          "type": "title",
          "settings": {
            "heading_size": "h1"
          }
        },
        "ss_pills": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"ss-pdp-pills\"><span>Jet fin et régulier</span><span>Design transparent</span><span>Installation sans outil</span></div>"
          }
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "ss_facts": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"ss-pdp-facts\"><div><b>Préoccupations</b>Eau calcaire, jet irrégulier, sensation de peau qui tire après la douche</div><div><b>Technologie</b>197 micro-trous de précision, filtration intégrée dans le manche</div><div><b>Durée d&#x27;utilisation</b>Durable : seules les recharges se remplacent</div></div>"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_type": "shopify_swatch",
            "swatch_style": "circle",
            "swatch_size": 32,
            "button_style": "normal",
            "size_title": "Size",
            "size_chart_from_page": ""
          }
        },
        "ss_systems": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'ss-systems', current: 'pommeau-de-douche-filtrant' %}"
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_quantity_selector": true,
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": false
          }
        },
        "reassurance": {
          "type": "icon-with-text",
          "settings": {
            "layout": "vertical",
            "title_font": "body",
            "title_size": "text-base",
            "icon_1": "check",
            "heading_1": "<strong>Sélection Sunsoari</strong> : marques choisies avec exigence",
            "icon_2": "truck",
            "heading_2": "<strong>Livraison suivie</strong> en France métropolitaine",
            "icon_3": "check",
            "heading_3": "<strong>Paiement sécurisé</strong> : CB, Apple Pay, PayPal"
          }
        },
        "acc_1": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Caractéristiques et matériaux",
            "heading_size": "h4",
            "icon": "none",
            "content": "<p>Polycarbonate (PC), polypropylène (PP), acier inoxydable, filtration intégrée. Matériaux annoncés conformes aux normes FDA par le fabricant. Compatible avec les flexibles de douche standard, la coque de diffusion Onsha Home et les filtres thermaux vitaminés.</p><p>Usage domestique uniquement. L'eau de la douche n'est pas destinée à la consommation. Ne pas forcer le vissage.</p>",
            "page": "",
            "default_open": false,
            "show_below_product_media": false
          }
        },
        "sticky_atc": {
          "type": "sticky-atc-bar",
          "settings": {
            "visibility": "all",
            "style": "minimalist",
            "container": "full",
            "show_atc_button": true,
            "show_dynamic_checkout_buttons": false,
            "show_quantity": true
          }
        },
        "ss_addon_1": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'ss-addon', addon: all_products['coque-de-diffusion'], variant_title: \"Grand format\", kind: 'indispensable', title: \"Pour le rituel thermal, ajoute :\", note: \"La coque Home se visse entre ton flexible et le pommeau, et maintient le filtre.\", section_id: section.id %}"
          }
        },
        "ss_addon_2": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'ss-addon', addon: all_products['filtre-vitamine-showerfilter-sunsoari'], variant_title: \"\", kind: 'indispensable', title: \"\", note: \"Le filtre thermal qui se glisse dans la coque. Senteur au choix.\", section_id: section.id %}"
          }
        },
        "ss_addon_3": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'ss-addon', addon: all_products['onsha-filtre-thermal-vitamine-sans-senteur'], variant_title: \"1 filtre\", kind: 'choix', title: \"\", note: \"Tu préfères sans parfum ? La même base de soin, sans senteur ajoutée.\", section_id: section.id %}"
          }
        }
      },
      "block_order": [
