{
  "sections": {
    "breadcrumbs": {
      "type": "breadcrumbs",
      "settings": {
        "container": "fixed",
        "text_alignment": "start",
        "padding_top": 16,
        "padding_bottom": 20
      }
    },
    "main": {
      "type": "main-product",
      "blocks": {
        "ss_badge": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<span class=\"ss-pdp-badge\">Ton premier rituel thermal</span>"
          }
        },
        "title": {
          "type": "title",
          "settings": {
            "heading_size": "h1"
          }
        },
        "ss_pills": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"ss-pdp-pills\"><span>Coque + 1 filtre</span><span>Senteur au choix</span><span>Pour ton pommeau Onsha</span></div>"
          }
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "ss_facts": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"ss-pdp-facts\"><div><b>Contenu</b>Coque de diffusion Home (Grand format) et 1 filtre thermal vitaminé</div><div><b>À savoir</b>Le pommeau filtrant Onsha n&#x27;est pas inclus : ajoute-le si tu ne l&#x27;as pas encore</div><div><b>Durée du filtre</b>3 à 4 semaines selon ta fréquence de douche</div></div>"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_type": "shopify_swatch",
            "swatch_style": "circle",
            "swatch_size": 32,
            "button_style": "normal",
            "size_title": "Size",
            "size_chart_from_page": ""
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_quantity_selector": true,
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": false
          }
        },
        "ss_checks": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<ul class=\"ss-checks\"><li><span><strong>Tout est prêt</strong> : tu visses, tu insères le filtre, c&#x27;est parti</span></li><li><span><strong>Senteur au choix</strong>, ou sans senteur</span></li><li><span><strong>Recharges disponibles</strong> à l&#x27;unité ou par lot</span></li></ul>"
          }
        },
        "reassurance": {
          "type": "icon-with-text",
          "settings": {
            "layout": "vertical",
            "title_font": "body",
            "title_size": "text-base",
            "icon_1": "check",
            "heading_1": "<strong>Sélection Sunsoari</strong> : marques choisies avec exigence",
            "icon_2": "truck",
            "heading_2": "<strong>Livraison suivie</strong> en France métropolitaine",
            "icon_3": "check",
            "heading_3": "<strong>Paiement sécurisé</strong> : CB, Apple Pay, PayPal"
          }
        },
        "acc_1": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Composition et principes actifs",
            "heading_size": "h4",
            "icon": "none",
            "content": "<p>Eau thermale soufrée extraite à 808 m dans le granit coréen, lyophilisée et concentrée 4 fois (données de la marque). Actifs de soin : vitamine C, acide hyaluronique, glycérine, MSM. Listes INCI complètes sur chaque emballage.</p>",
            "page": "",
            "default_open": false,
            "show_below_product_media": false
          }
        },
        "acc_2": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Durée et entretien",
            "heading_size": "h4",
            "icon": "none",
            "content": "<p>Le filtre dure environ 3 à 4 semaines selon ta fréquence de douche. Rince régulièrement la coque de diffusion. Le pommeau et la coque se gardent : seuls les filtres se remplacent.</p>",
            "page": "",
            "default_open": false,
            "show_below_product_media": false
          }
        },
        "sticky_atc": {
          "type": "sticky-atc-bar",
          "settings": {
            "visibility": "all",
            "style": "minimalist",
            "container": "full",
            "show_atc_button": true,
            "show_dynamic_checkout_buttons": false,
            "show_quantity": true
          }
        },
        "ss_addon_1": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'ss-addon', addon: all_products['pommeau-de-douche-filtrant'], variant_title: \"\", kind: 'indispensable', title: \"Pour utiliser ton rituel, il te faut aussi :\", note: \"La pomme de douche filtrante qui se visse sur la coque. À ajouter si tu ne l'as pas encore.\", section_id: section.id %}"
          }
        }
      },
      "block_order": [
        "ss_badge",
        "title",
        "ss_pills",
        "price",
        "description",
        "variant_picker",
        "ss_addon_1",
        "buy_buttons",
        "ss_checks",
        "ss_facts",
        "reassurance",
        "acc_1",
        "acc_2",
        "sticky_atc"
      ],
      "custom_css": [
        "@media (min-width: 1280px) {.product {padding-inline: 5rem; }}"
      ],
      "settings": {
        "color_scheme": "scheme-1",
        "use_color_scheme_in_container": false,
        "enable_sticky_info": true,
        "media_size": "large",
        "gallery_layout": "vertical-carousel",
        "mobile_thumbnails": "show",
        "show_image_border": false,
        "enable_image_zoom": true,
        "enable_video_looping": true,
        "padding_top": 0,
        "padding_bottom": 40
      }
    },
