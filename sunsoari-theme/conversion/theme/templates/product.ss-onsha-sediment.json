{
  "sections": {
    "breadcrumbs": {
      "type": "breadcrumbs",
      "settings": {
        "container": "fixed",
        "text_alignment": "start",
        "padding_top": 16,
        "padding_bottom": 20
      }
    },
    "main": {
      "type": "main-product",
      "blocks": {
        "ss_badge": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<span class=\"ss-pdp-badge\">La recharge essentielle</span>"
          }
        },
        "title": {
          "type": "title",
          "settings": {
            "heading_size": "h1"
          }
        },
        "ss_pills": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"ss-pdp-pills\"><span>Se change toutes les 4 à 6 semaines</span><span>Installation en quelques secondes</span><span>Pour la douchette Onsha</span></div>"
          }
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "ss_facts": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"ss-pdp-facts\"><div><b>Rôle</b>Filtration mécanique qui retient les sédiments et particules visibles</div><div><b>Compatibilité</b>Douchette filtrante Onsha uniquement</div><div><b>Durée d&#x27;utilisation</b>4 à 6 semaines selon ton eau et ta fréquence de douche</div></div>"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_type": "shopify_swatch",
            "swatch_style": "circle",
            "swatch_size": 32,
            "button_style": "normal",
            "size_title": "Size",
            "size_chart_from_page": ""
          }
        },
        "ss_offers": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'ss-offers', product: product, section_id: section.id, tiers: '1:0,2:5,4:10', singular: \"filtre\", plural: \"filtres\", title: \"Choisis ta quantité\" %}"
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_quantity_selector": true,
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": false
          }
        },
        "reassurance": {
          "type": "icon-with-text",
          "settings": {
            "layout": "vertical",
            "title_font": "body",
            "title_size": "text-base",
            "icon_1": "check",
            "heading_1": "<strong>Sélection Sunsoari</strong> : marques choisies avec exigence",
            "icon_2": "truck",
            "heading_2": "<strong>Livraison suivie</strong> en France métropolitaine",
            "icon_3": "check",
            "heading_3": "<strong>Paiement sécurisé</strong> : CB, Apple Pay, PayPal"
          }
        },
        "acc_1": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Composition",
            "heading_size": "h4",
            "icon": "none",
            "content": "<p>Filtration mécanique multi-couches. Usage externe uniquement, dans la douchette Onsha. L'eau filtrée n'est pas destinée à la consommation. Conçu en Corée.</p>",
            "page": "",
            "default_open": false,
            "show_below_product_media": false
          }
        },
        "sticky_atc": {
          "type": "sticky-atc-bar",
          "settings": {
            "visibility": "all",
            "style": "minimalist",
            "container": "full",
            "show_atc_button": true,
            "show_dynamic_checkout_buttons": false,
            "show_quantity": true
          }
        },
        "ss_addon_1": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'ss-addon', addon: all_products['douchette-filtrante'], variant_title: \"\", kind: 'indispensable', title: \"\", note: \"Pas encore la douchette ? Filtre inclus, installation sans outil.\", section_id: section.id %}"
          }
        }
      },
      "block_order": [
        "ss_badge",
        "title",
        "ss_pills",
        "price",
        "description",
        "variant_picker",
        "ss_offers",
        "ss_addon_1",
        "buy_buttons",
        "ss_facts",
        "reassurance",
        "acc_1",
        "sticky_atc"
      ],
      "custom_css": [
        "@media (min-width: 1280px) {.product {padding-inline: 5rem; }}"
      ],
      "settings": {
        "color_scheme": "scheme-1",
        "use_color_scheme_in_container": false,
        "enable_sticky_info": true,
        "media_size": "large",
        "gallery_layout": "vertical-carousel",
        "mobile_thumbnails": "show",
        "show_image_border": false,
        "enable_image_zoom": true,
        "enable_video_looping": true,
        "padding_top": 0,
        "padding_bottom": 40
      }
    },
