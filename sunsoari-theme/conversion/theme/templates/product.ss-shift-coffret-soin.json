        "ss_facts": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"ss-pdp-facts\"><div><b>Contenu</b>Pomme de douche filtrante, capsule Tea Tree &amp; Lavender, filtre Pure Water</div><div><b>Installation</b>2 minutes, sans outil, sur tout flexible standard</div><div><b>Recharges</b>Capsules et filtres Pure Water disponibles séparément</div></div>"
