          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'ss-addon', addon: all_products['pack-6-capsules-vitaminees-shift-sunsoari'], variant_title: \"\", kind: 'complement', title: \"Prends de l'avance sur tes recharges :\", note: \"6 capsules soin et aromathérapie, collection au choix.\", section_id: section.id %}"
          }
        },
        "ss_addon_2": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'ss-addon', addon: all_products['pack-3-sediments-pure-water'], variant_title: \"\", kind: 'complement', title: \"\", note: \"3 filtres Pure Water pour ta pomme de douche SHIFT.\", section_id: section.id %}"
          }
