            "heading_3": "<strong>Paiement sécurisé</strong> : CB, Apple Pay, PayPal"
          }
        },
        "acc_1": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Ingrédients de la capsule",
            "heading_size": "h4",
            "icon": "none",
            "content": "<p>Huile essentielle de tea tree et de lavande, associées à des actifs hydratants (glycérine, acide hyaluronique). La liste INCI complète et les allergènes figurent sur l'emballage.</p>",
            "page": "",
            "default_open": false,
            "show_below_product_media": false
          }
        },
        "acc_2": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Précautions",
            "heading_size": "h4",
            "icon": "none",
            "content": "<p>Usage externe et domestique uniquement. En cas de sensibilité connue aux parfums ou aux huiles essentielles, consulte la liste INCI avant utilisation. Ne force pas le vissage.</p>",
            "page": "",
            "default_open": false,
            "show_below_product_media": false
          }
        },
        "sticky_atc": {
          "type": "sticky-atc-bar",
          "settings": {
            "visibility": "all",
            "style": "minimalist",
            "container": "full",
            "show_atc_button": true,
            "show_dynamic_checkout_buttons": false,
            "show_quantity": true
          }
        },
