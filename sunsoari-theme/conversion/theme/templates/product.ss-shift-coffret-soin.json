          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<ul class=\"ss-checks\"><li><span>Système complet : <strong>rien d'autre à acheter</strong> pour commencer</span></li><li><span><strong>Soin et filtration</strong> dans une seule douche</span></li><li><span>S'installe <strong>en deux minutes</strong>, sans outil</span></li></ul>"
          }
        },
        "reassurance": {
          "type": "icon-with-text",
          "settings": {
            "layout": "vertical",
            "title_font": "body",
            "title_size": "text-base",
            "icon_1": "check",
            "heading_1": "<strong>Sélection Sunsoari</strong> : marques choisies avec exigence",
            "icon_2": "truck",
            "heading_2": "<strong>Livraison suivie</strong> en France métropolitaine",
