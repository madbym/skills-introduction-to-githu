{%- comment -%}
  Sunsoari · « Composez votre rituel »
  Pack builder inspired by Paalm: browse categories, pick products from their
  photos, choose the variant, see the pack build up, then add everything to the
  cart at once. Discount tiers are only displayed when they are filled in the
  editor: they must match an automatic discount created in Shopify.
{%- endcomment -%}

<section
  class="ss-builder color-{{ section.settings.color_scheme }}"
  id="ss-builder-{{ section.id }}"
  data-tier1-qty="{{ section.settings.tier1_qty }}"
  data-tier1-pct="{{ section.settings.tier1_pct }}"
  data-tier2-qty="{{ section.settings.tier2_qty }}"
  data-tier2-pct="{{ section.settings.tier2_pct }}"
  data-tier3-qty="{{ section.settings.tier3_qty }}"
  data-tier3-pct="{{ section.settings.tier3_pct }}"
  data-money-format="{{ shop.money_format | escape }}"
>
  <div class="ss-builder__intro">
    {%- if section.settings.eyebrow != blank -%}<p class="ss-builder__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1 class="ss-builder__title">{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}<div class="ss-builder__text">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.tier1_qty > 0 and section.settings.tier1_pct > 0 -%}
      <ul class="ss-builder__tiers">
        {%- for i in (1..3) -%}
          {%- capture qk -%}tier{{ i }}_qty{%- endcapture -%}
          {%- capture pk -%}tier{{ i }}_pct{%- endcapture -%}
          {%- if section.settings[qk] > 0 and section.settings[pk] > 0 -%}
            <li class="ss-pill">{{ section.settings[qk] }} produits : -{{ section.settings[pk] }} %</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  <div class="ss-builder__layout">
    <div class="ss-builder__catalog">
      <div class="ss-builder__tabs" role="tablist">
        {%- for block in section.blocks -%}
          {%- if block.settings.collection != blank -%}
            <button type="button" class="ss-pill ss-builder__tab{% if forloop.first %} is-active{% endif %}" data-tab="{{ block.id }}" role="tab" {{ block.shopify_attributes }}>
              {{ block.settings.label | default: block.settings.collection.title }}
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- for block in section.blocks -%}
        {%- assign col = block.settings.collection -%}
        {%- if col != blank -%}
          <div class="ss-builder__panel{% if forloop.first %} is-active{% endif %}" data-panel="{{ block.id }}">
            {%- if block.settings.note != blank -%}<p class="ss-builder__note">{{ block.settings.note }}</p>{%- endif -%}
            <div class="ss-builder__grid">
              {%- for product in col.products limit: 24 -%}
                {%- if product.available -%}
                  <article class="ss-card" data-product-title="{{ product.title | escape }}">
                    <div class="ss-card__media">
                      {%- if product.featured_image -%}
                        {{ product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '200,300,400,500', sizes: '(min-width: 990px) 220px, 45vw', alt: product.title }}
                      {%- endif -%}
                    </div>
                    <p class="ss-card__title">{{ product.title }}</p>
                    {%- if product.has_only_default_variant -%}
                      <input type="hidden" class="ss-card__variant" value="{{ product.selected_or_first_available_variant.id }}"
                        data-price="{{ product.selected_or_first_available_variant.price }}"
                        data-label=""
                        data-image="{{ product.featured_image | image_url: width: 120 }}">
                    {%- else -%}
                      <select class="ss-card__variant ss-select" aria-label="Variante de {{ product.title | escape }}">
                        {%- for variant in product.variants -%}
                          {%- if variant.available -%}
                            <option value="{{ variant.id }}"
                              data-price="{{ variant.price }}"
                              data-label="{{ variant.title | escape }}"
                              data-image="{{ variant.image | default: product.featured_image | image_url: width: 120 }}">
                              {{ variant.title }} · {{ variant.price | money }}
                            </option>
                          {%- endif -%}
                        {%- endfor -%}
                      </select>
                    {%- endif -%}
                    <div class="ss-card__footer">
                      <span class="ss-card__price">{{ product.price | money }}</span>
                      <button type="button" class="ss-btn ss-btn--small ss-card__add">Ajouter</button>
                    </div>
                  </article>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <aside class="ss-builder__summary" aria-live="polite">
      <p class="ss-builder__summary-title">{{ section.settings.summary_title }}</p>
      <p class="ss-builder__empty">{{ section.settings.empty_text }}</p>
      <ul class="ss-builder__items"></ul>
      <div class="ss-builder__totals">
        <p><span>Sous-total</span><span class="ss-builder__subtotal">—</span></p>
        <p class="ss-builder__discount-row" hidden><span>Remise estimée</span><span class="ss-builder__discount">—</span></p>
        <p class="ss-builder__total-row"><span>Total</span><span class="ss-builder__total">—</span></p>
      </div>
      <button type="button" class="ss-btn ss-builder__submit" disabled>{{ section.settings.button_label }}</button>
      {%- if section.settings.legal != blank -%}<p class="ss-builder__legal">{{ section.settings.legal }}</p>{%- endif -%}
    </aside>
  </div>
</section>

<style>
  #ss-builder-{{ section.id }} {
    --ss-indigo: #032B59; --ss-ardoise: #7591AA; --ss-brume: #C4D3E4;
    --ss-sable: #E6DED1; --ss-coquille: #EEEBE7; --ss-blanc: #FAF8F5;
    font-family: inherit; color: var(--ss-indigo);
    max-width: 1320px; margin: 0 auto; padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
  }
  .ss-builder__intro { text-align: center; max-width: 680px; margin: 0 auto 32px; }
  .ss-builder__eyebrow { letter-spacing: .12em; text-transform: uppercase; font-size: 12px; color: var(--ss-ardoise); margin: 0 0 8px; }
  .ss-builder__title { margin: 0 0 12px; }
  .ss-builder__tiers { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; list-style: none; padding: 0; margin: 16px 0 0; }
  .ss-pill { border: 1px solid var(--ss-brume); background: #fff; color: var(--ss-indigo); border-radius: 999px; padding: 8px 16px; font: inherit; font-size: 14px; cursor: pointer; }
  .ss-pill.is-active, .ss-builder__tiers .ss-pill { background: var(--ss-indigo); color: #fff; border-color: var(--ss-indigo); }
  .ss-builder__layout { display: grid; grid-template-columns: 1fr; gap: 24px; }
  @media (min-width: 990px) { .ss-builder__layout { grid-template-columns: minmax(0, 1fr) 360px; align-items: start; } .ss-builder__summary { position: sticky; top: 100px; } }
  .ss-builder__tabs { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 12px; margin-bottom: 8px; }
  .ss-builder__panel { display: none; } .ss-builder__panel.is-active { display: block; }
  .ss-builder__note { background: var(--ss-coquille); border-radius: 14px; padding: 12px 16px; font-size: 14px; margin: 0 0 16px; }
  .ss-builder__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  @media (min-width: 750px) { .ss-builder__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; } }
  .ss-card { background: #fff; border: 1px solid var(--ss-brume); border-radius: 20px; padding: 12px; display: flex; flex-direction: column; gap: 8px; }
  .ss-card__media { aspect-ratio: 1; border-radius: 14px; overflow: hidden; background: var(--ss-coquille); }
  .ss-card__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ss-card__title { font-size: 14px; font-weight: 500; margin: 0; line-height: 1.3; }
  .ss-select { width: 100%; border: 1px solid var(--ss-brume); border-radius: 12px; padding: 8px 10px; font: inherit; font-size: 13px; background: #fff; color: var(--ss-indigo); }
  .ss-card__footer { margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .ss-card__price { font-size: 14px; }
  .ss-btn { background: var(--ss-indigo); color: #fff; border: 0; border-radius: 999px; padding: 14px 20px; font: inherit; font-weight: 500; cursor: pointer; width: 100%; }
  .ss-btn--small { width: auto; padding: 8px 14px; font-size: 13px; }
  .ss-btn[disabled] { opacity: .45; cursor: not-allowed; }
  .ss-builder__summary { background: var(--ss-coquille); border: 1px solid var(--ss-sable); border-radius: 22px; padding: 20px; }
  .ss-builder__summary-title { font-weight: 600; margin: 0 0 8px; }
  .ss-builder__empty { font-size: 14px; color: var(--ss-ardoise); }
  .ss-builder__items { list-style: none; margin: 0 0 12px; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .ss-builder__items li { display: grid; grid-template-columns: 48px 1fr auto; gap: 10px; align-items: center; background: #fff; border-radius: 14px; padding: 8px; font-size: 13px; }
  .ss-builder__items img { width: 48px; height: 48px; object-fit: cover; border-radius: 10px; }
  .ss-builder__items button { border: 0; background: none; color: var(--ss-ardoise); cursor: pointer; font-size: 18px; line-height: 1; }
  .ss-builder__qty { display: inline-flex; gap: 6px; align-items: center; margin-top: 2px; }
  .ss-builder__qty button { border: 1px solid var(--ss-brume) !important; border-radius: 999px; width: 24px; height: 24px; font-size: 14px !important; }
  .ss-builder__totals p { display: flex; justify-content: space-between; margin: 4px 0; font-size: 14px; }
  .ss-builder__total-row { font-weight: 600; font-size: 16px !important; margin-bottom: 14px !important; }
  .ss-builder__legal { font-size: 12px; color: var(--ss-ardoise); margin: 10px 0 0; }
</style>

<script>
  (() => {
    const root = document.getElementById('ss-builder-{{ section.id }}');
    if (!root) return;
    const fmt = (cents) => (cents / 100).toLocaleString('fr-FR', { style: 'currency', currency: '{{ cart.currency.iso_code | default: "EUR" }}' });
    const tiers = [1, 2, 3]
      .map((i) => ({ qty: +root.dataset[`tier${i}Qty`] || 0, pct: +root.dataset[`tier${i}Pct`] || 0 }))
      .filter((t) => t.qty > 0 && t.pct > 0)
      .sort((a, b) => b.qty - a.qty);
    const pack = new Map();

    root.querySelectorAll('.ss-builder__tab').forEach((tab) => {
      tab.addEventListener('click', () => {
        root.querySelectorAll('.ss-builder__tab').forEach((t) => t.classList.toggle('is-active', t === tab));
        root.querySelectorAll('.ss-builder__panel').forEach((p) => p.classList.toggle('is-active', p.dataset.panel === tab.dataset.tab));
      });
    });

    root.querySelectorAll('.ss-card').forEach((card) => {
      const input = card.querySelector('.ss-card__variant');
      const priceEl = card.querySelector('.ss-card__price');
      const current = () => (input.tagName === 'SELECT' ? input.selectedOptions[0] : input);
      if (input.tagName === 'SELECT') input.addEventListener('change', () => (priceEl.textContent = fmt(+current().dataset.price)));
      card.querySelector('.ss-card__add').addEventListener('click', () => {
        const opt = current();
        const id = opt.value;
        const line = pack.get(id) || { id, qty: 0, price: +opt.dataset.price, image: opt.dataset.image,
          title: card.dataset.productTitle, variant: opt.dataset.label };
        line.qty += 1;
        pack.set(id, line);
        render();
      });
    });

    function render() {
      const list = root.querySelector('.ss-builder__items');
      list.innerHTML = '';
      let count = 0, subtotal = 0;
      pack.forEach((line) => {
        count += line.qty; subtotal += line.qty * line.price;
        const li = document.createElement('li');
        li.innerHTML = `<img src="${line.image}" alt=""><div><strong>${line.title}</strong>${line.variant ? `<br>${line.variant}` : ''}
          <div class="ss-builder__qty"><button type="button" data-d="-1" aria-label="Retirer un">−</button>${line.qty}<button type="button" data-d="1" aria-label="Ajouter un">+</button></div></div>
          <span>${fmt(line.qty * line.price)}</span>`;
        li.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => {
          line.qty += +b.dataset.d;
          if (line.qty <= 0) pack.delete(line.id);
          render();
        }));
        list.appendChild(li);
      });
      const tier = tiers.find((t) => count >= t.qty);
      const discount = tier ? Math.round((subtotal * tier.pct) / 100) : 0;
      root.querySelector('.ss-builder__empty').hidden = count > 0;
      root.querySelector('.ss-builder__subtotal').textContent = count ? fmt(subtotal) : '—';
      root.querySelector('.ss-builder__discount-row').hidden = !discount;
      root.querySelector('.ss-builder__discount').textContent = discount ? `-${fmt(discount)}` : '—';
      root.querySelector('.ss-builder__total').textContent = count ? fmt(subtotal - discount) : '—';
      root.querySelector('.ss-builder__submit').disabled = count === 0;
    }

    root.querySelector('.ss-builder__submit').addEventListener('click', async (e) => {
      const btn = e.currentTarget;
      btn.disabled = true;
      const items = [...pack.values()].map((l) => ({ id: +l.id, quantity: l.qty, properties: { _rituel: 'Composez votre rituel' } }));
      try {
        const res = await fetch('{{ routes.cart_add_url }}.js', {
          method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ items }),
        });
        if (!res.ok) throw new Error((await res.json()).description || 'Erreur');
        window.location.href = '{{ routes.cart_url }}';
      } catch (err) {
        alert(`Impossible d'ajouter ton rituel au panier : ${err.message}`);
        btn.disabled = false;
      }
    });
    render();
  })();
</script>

{% schema %}
{
  "name": "Composez votre rituel",
  "tag": "div",
  "class": "section-ss-builder",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Couleurs", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Sunsoari" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Composez votre rituel" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Choisis ton système, tes recharges et tes accessoires : ton pack se construit à droite, puis s'ajoute au panier en une fois.</p>" },
    { "type": "text", "id": "summary_title", "label": "Titre du récapitulatif", "default": "Mon rituel" },
    { "type": "text", "id": "empty_text", "label": "Texte si vide", "default": "Ajoute tes premiers produits pour composer ton rituel." },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Ajouter mon rituel au panier" },
    { "type": "text", "id": "legal", "label": "Mention sous le bouton", "default": "Les remises s'appliquent automatiquement au paiement." },
    { "type": "header", "content": "Paliers de remise" },
    { "type": "paragraph", "content": "À remplir uniquement si une remise automatique identique existe dans Shopify > Réductions. Laisser à 0 sinon." },
    { "type": "number", "id": "tier1_qty", "label": "Palier 1 : nombre de produits", "default": 0 },
    { "type": "number", "id": "tier1_pct", "label": "Palier 1 : remise (%)", "default": 0 },
    { "type": "number", "id": "tier2_qty", "label": "Palier 2 : nombre de produits", "default": 0 },
    { "type": "number", "id": "tier2_pct", "label": "Palier 2 : remise (%)", "default": 0 },
    { "type": "number", "id": "tier3_qty", "label": "Palier 3 : nombre de produits", "default": 0 },
    { "type": "number", "id": "tier3_pct", "label": "Palier 3 : remise (%)", "default": 0 },
    { "type": "header", "content": "Espacements" },
    { "type": "range", "id": "padding_top", "label": "Haut", "min": 0, "max": 120, "step": 4, "default": 48, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bas", "min": 0, "max": 120, "step": 4, "default": 64, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Catégorie",
      "settings": [
        { "type": "text", "id": "label", "label": "Nom de l'onglet" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "note", "label": "Info compatibilité" }
      ]
    }
  ],
  "presets": [{ "name": "Composez votre rituel" }]
}
{% endschema %}
