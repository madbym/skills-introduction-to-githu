              "blocks": {
                "accordion_iMdfeZ": {
                  "type": "_accordion",
                  "settings": {
                    "heading": "Ai-je besoin de cette coque si j'ai le coffret ?"
                  },
                  "blocks": {
                    "text_faq": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Non : le Coffret Douche Thermal Coréen (Home) inclut déjà la coque. Celle-ci s'adresse à celles qui ont déjà le pommeau, ou qui veulent une pièce de rechange.</p>",
                        "text_style": "paragraph"
                      }
                    }
                  },
                  "block_order": [
                    "text_faq"
                  ]
                },
                "accordion_04KvUi": {
                  "type": "_accordion",
                  "settings": {
                    "heading": "Quels filtres s'insèrent dans cette coque ?"
                  },
                  "blocks": {
                    "text_faq": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Les Filtres Thermaux Vitaminés format Home, en 4 senteurs ou sans senteur. Les capsules Nomade sont trop petites pour cette coque.</p>",
                        "text_style": "paragraph"
                      }
                    }
                  },
                  "block_order": [
                    "text_faq"
                  ]
                },
                "accordion_amrIP4": {
                  "type": "_accordion",
                  "settings": {
                    "heading": "Dois-je la remplacer régulièrement ?"
                  },
                  "blocks": {
                    "text_faq": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Non, la coque est conçue pour durer. Seuls les filtres se remplacent, environ toutes les 3 à 4 semaines.</p>",
                        "text_style": "paragraph"
                      }
                    }
                  },
                  "block_order": [
                    "text_faq"
                  ]
                },
                "accordion_aOu7bn": {
                  "type": "_accordion",
                  "settings": {
                    "heading": "Est-ce que je peux l'installer moi-même ?"
                  },
                  "blocks": {
                    "text_faq": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Oui ! Elle se fixe à la main sur tout flexible standard, en quelques secondes, sans outil ni plombier.</p>",
                        "text_style": "paragraph"
                      }
                    }
                  },
                  "block_order": [
                    "text_faq"
                  ]
