              }
            },
            "accordions_hpBMaf": {
              "type": "accordions",
              "name": "Accordéons",
              "settings": {
                "icon": "add",
                "accordion_padding": "medium"
              },
              "blocks": {
                "accordion_WFfVTv": {
                  "type": "_accordion",
                  "settings": {
                    "heading": "Pourquoi ce set plutôt que chaque pièce seule ?"
                  },
                  "blocks": {
                    "text_faq": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Le Set Découverte Home regroupe la coque et 4 filtres à un prix plus doux que l'achat séparé. Parfait pour démarrer et explorer les quatre senteurs.</p>",
                        "text_style": "paragraph"
                      }
                    }
                  },
                  "block_order": [
                    "text_faq"
                  ]
                },
                "accordion_VKqgPF": {
                  "type": "_accordion",
                  "settings": {
                    "heading": "Avec quel pommeau associer ce set ?"
                  },
                  "blocks": {
                    "text_faq": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Avec le Pommeau de Douche Filtrant Onsha, pour le système complet Home. Tu peux aussi choisir le Coffret Douche Thermal Coréen (Home), qui réunit tout.</p>",
                        "text_style": "paragraph"
                      }
                    }
                  },
                  "block_order": [
                    "text_faq"
                  ]
                },
                "accordion_9BFmYI": {
                  "type": "_accordion",
                  "settings": {
                    "heading": "Combien de temps dure chaque filtre ?"
                  },
                  "blocks": {
                    "text_faq": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Environ 3 à 4 semaines par filtre. Avec 4 filtres, tu as 3 à 4 mois de rituel.</p>",
                        "text_style": "paragraph"
                      }
                    }
                  },
                  "block_order": [
                    "text_faq"
                  ]
                },
                "accordion_uaw6fP": {
                  "type": "_accordion",
                  "settings": {
                    "heading": "Puis-je racheter des senteurs ensuite ?"
                  },
                  "blocks": {
                    "text_faq": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Oui ! Les Filtres Thermaux Vitaminés (Home) sont vendus à l'unité ou en pack de 2 ou 4, dans chacune des quatre senteurs.</p>",
                        "text_style": "paragraph"
                      }
                    }
                  },
                  "block_order": [
                    "text_faq"
                  ]
                }
              },
