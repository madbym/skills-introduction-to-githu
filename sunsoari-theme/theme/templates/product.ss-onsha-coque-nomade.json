              "name": "Titre",
              "settings": {
                "text": "<h3>Questions fréquentes</h3>",
                "text_style": "h2",
                "margin_bottom": 10
              }
            },
            "accordions_hpBMaf": {
              "type": "accordions",
              "name": "Accordéons",
              "settings": {
                "icon": "add",
                "accordion_padding": "medium"
              },
              "blocks": {
                "accordion_TBJahe": {
                  "type": "_accordion",
                  "settings": {
                    "heading": "Ai-je besoin de cette coque si j'ai le coffret Nomade ?"
                  },
                  "blocks": {
                    "text_OqkVCJ": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Non : le Coffret Nomade et le Set Découverte Nomade incluent déjà la coque. Celle-ci s'adresse à celles qui ont déjà la douchette, ou qui veulent une pièce de rechange.</p>",
                        "text_style": "paragraph"
                      }
                    }
                  },
                  "block_order": [
                    "text_OqkVCJ"
                  ]
                },
                "accordion_c1xLJj": {
                  "type": "_accordion",
                  "settings": {
                    "heading": "Quelles recharges s'insèrent dans cette coque ?"
                  },
                  "blocks": {
                    "text_84S5jI": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Les capsules thermales Onsha format Mini (Nomade), avec leur disque sédiment. Les filtres thermaux Home sont trop grands pour cette coque.</p>",
                        "text_style": "paragraph"
                      }
                    }
                  },
                  "block_order": [
                    "text_84S5jI"
                  ]
                },
                "accordion_7Y3c5w": {
                  "type": "_accordion",
                  "settings": {
                    "heading": "Dois-je la remplacer régulièrement ?"
                  },
                  "blocks": {
                    "text_Bictx5": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Non, la coque est conçue pour durer. Seules les capsules et leurs disques se remplacent, environ tous les 10 à 15 jours.</p>",
                        "text_style": "paragraph"
                      }
                    }
                  },
                  "block_order": [
                    "text_Bictx5"
                  ]
                },
                "accordion_XJ43AN": {
                  "type": "_accordion",
                  "settings": {
                    "heading": "Est-ce que je peux l'installer moi-même ?"
                  },
                  "blocks": {
                    "text_nRpQgw": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Oui ! Elle se fixe à la main, en quelques secondes, sans outil ni plombier.</p>",
                        "text_style": "paragraph"
                      }
                    }
                  },
                  "block_order": [
                    "text_nRpQgw"
                  ]
                },
                "accordion_kZZl4A": {
                  "type": "_accordion",
                  "settings": {
                    "heading": "Quels sont les délais de livraison ?"
                  },
                  "blocks": {
                    "text_Vj77p3": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Ta commande est préparée avec soin et expédiée en livraison suivie partout en France métropolitaine. Les délais et frais exacts s'affichent au moment du paiement.</p>",
                        "text_style": "paragraph"
                      }
                    }
                  },
                  "block_order": [
                    "text_Vj77p3"
                  ]
                },
                "accordion_7AZQ3V": {
                  "type": "_accordion",
                  "settings": {
                    "heading": "Puis-je retourner le produit ?"
                  },
                  "blocks": {
                    "text_blV7vY": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Oui, sous 14 jours, à condition que le produit soit non ouvert, non utilisé, complet et dans son emballage d'origine, pour des raisons d'hygiène. Tous les détails sont dans notre politique de retours.</p>",
                        "text_style": "paragraph"
                      }
                    }
                  },
                  "block_order": [
                    "text_blV7vY"
                  ]
                }
