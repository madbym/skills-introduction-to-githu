                    "heading": "Avec quels produits la housse est-elle compatible ?"
                  },
                  "blocks": {
                    "text_faq": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Elle est conçue uniquement pour la Douchette Filtrante Onsha, dont elle épouse la forme.</p>",
                        "text_style": "paragraph"
