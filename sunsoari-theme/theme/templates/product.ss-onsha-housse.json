                      "type": "text",
                      "settings": {
                        "text": "<p>Un simple lavage à l'eau tiède suffit.</p>",
                        "text_style": "paragraph"
                      }
                    }
                  },
                  "block_order": [
                    "text_faq"
                  ]
                },
                "accordion_dLltTI": {
                  "type": "_accordion",
                  "settings": {
                    "heading": "Gêne-t-elle l'utilisation de la douchette ?"
                  },
                  "blocks": {
                    "text_faq": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Non : elle épouse la forme de la douchette sans gêner la prise en main, le jet ni le changement de filtre.</p>",
