                    }
                  },
                  "block_order": [
                    "text_faq"
                  ]
                },
                "accordion_xHvZyq": {
                  "type": "_accordion",
                  "settings": {
                    "heading": "Les clips sont-ils inclus ?"
                  },
                  "blocks": {
                    "text_faq": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Oui, des clips décoratifs sont inclus selon le coloris choisi. Tu peux ensuite les combiner entre coloris.</p>",
                        "text_style": "paragraph"
                      }
                    }
                  },
                  "block_order": [
                    "text_faq"
                  ]
                },
                "accordion_bJmaKq": {
