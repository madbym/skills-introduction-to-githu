                  "settings": {
                    "heading": "Avec quel système ce filtre est-il compatible ?"
                  },
                  "blocks": {
                    "text_faq": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Il s'insère dans la Douchette Filtrante Onsha. Attention : ce n'est pas le Filtre Thermal Vitaminé du système Home.</p>",
                        "text_style": "paragraph"
                      }
                    }
                  },
                  "block_order": [
                    "text_faq"
                  ]
                },
                "accordion_hY1tZe": {
                  "type": "_accordion",
                  "settings": {
                    "heading": "Combien de temps dure un filtre ?"
                  },
                  "blocks": {
                    "text_faq": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Environ 4 à 6 semaines selon ta fréquence de douche et la qualité de ton eau.</p>",
                        "text_style": "paragraph"
                      }
                    }
                  },
                  "block_order": [
                    "text_faq"
                  ]
                },
                "accordion_UJDgVJ": {
                  "type": "_accordion",
                  "settings": {
                    "heading": "Pourquoi le filtre change-t-il de couleur ?"
                  },
                  "blocks": {
                    "text_faq": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Parce qu'il retient les sédiments de l'eau : c'est le signe que ta filtration travaille.</p>",
                        "text_style": "paragraph"
                      }
                    }
                  },
                  "block_order": [
                    "text_faq"
                  ]
                },
                "accordion_hYkMzD": {
                  "type": "_accordion",
                  "settings": {
                    "heading": "Existe-t-il plusieurs versions ?"
                  },
                  "blocks": {
                    "text_faq": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Non, une seule version, compatible avec la Douchette Filtrante Onsha.</p>",
                        "text_style": "paragraph"
                      }
