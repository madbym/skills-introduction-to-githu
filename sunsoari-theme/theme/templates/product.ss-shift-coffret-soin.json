            "accordions_hpBMaf": {
              "type": "accordions",
              "name": "Accordéons",
              "settings": {
                "icon": "add",
                "accordion_padding": "medium"
              },
              "blocks": {
                "accordion_EvRWT9": {
                  "type": "_accordion",
                  "settings": {
                    "heading": "Le coffret contient-il tout pour commencer ?"
                  },
                  "blocks": {
                    "text_faq": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Oui ! Pommeau, capsule de soin et filtre : tu installes et ton rituel commence. Aucun autre achat nécessaire.</p>",
                        "text_style": "paragraph"
                      }
                    }
                  },
                  "block_order": [
                    "text_faq"
                  ]
                },
                "accordion_P4lD9u": {
                  "type": "_accordion",
                  "settings": {
                    "heading": "Combien de temps durent la capsule et le filtre ?"
                  },
                  "blocks": {
                    "text_faq": {
                      "type": "text",
                      "settings": {
                        "text": "<p>La capsule dure selon ta fréquence de douche, tu la remplaces par une autre senteur SHIFT quand elle est vide. Le filtre Pure Water se change environ tous les 2 à 3 mois.</p>",
                        "text_style": "paragraph"
                      }
                    }
                  },
                  "block_order": [
                    "text_faq"
                  ]
                },
                "accordion_YoBf9n": {
                  "type": "_accordion",
                  "settings": {
                    "heading": "Est-ce compatible avec ma douche ?"
                  },
                  "blocks": {
                    "text_faq": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Le système s'installe sur tous les flexibles de douche standard, à la main, sans outil, en deux minutes.</p>",
                        "text_style": "paragraph"
                      }
                    }
                  },
                  "block_order": [
                    "text_faq"
                  ]
                },
                "accordion_IAz9i5": {
                  "type": "_accordion",
                  "settings": {
                    "heading": "Les senteurs conviennent-elles aux peaux sensibles ?"
                  },
                  "blocks": {
                    "text_faq": {
                      "type": "text",
                      "settings": {
                        "text": "<p>La capsule s'utilise diffusée dans l'eau de la douche. Elle contient des huiles essentielles : en cas de sensibilité connue aux parfums, consulte la liste INCI avant utilisation.</p>",
                        "text_style": "paragraph"
                      }
                    }
                  },
                  "block_order": [
                    "text_faq"
                  ]
                }
              },
