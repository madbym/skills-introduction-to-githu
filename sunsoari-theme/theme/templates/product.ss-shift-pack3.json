            "accordions_hpBMaf": {
              "type": "accordions",
              "name": "Accordéons",
              "settings": {
                "icon": "add",
                "accordion_padding": "medium"
              },
              "blocks": {
                "accordion_E9L7Nk": {
                  "type": "_accordion",
                  "settings": {
                    "heading": "Combien de temps durent ces filtres ?"
                  },
                  "blocks": {
                    "text_faq": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Environ 2 à 3 mois chacun. Avec ce pack de 3, tu as 6 à 9 mois d'avance.</p>",
                        "text_style": "paragraph"
                      }
                    }
                  },
                  "block_order": [
                    "text_faq"
                  ]
                },
                "accordion_u5ymr5": {
                  "type": "_accordion",
                  "settings": {
                    "heading": "Sont-ils compatibles avec mon pommeau SHIFT ?"
                  },
                  "blocks": {
                    "text_faq": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Oui, ils sont conçus pour le Pommeau de Douche Filtrant SHIFT.</p>",
                        "text_style": "paragraph"
                      }
                    }
                  },
                  "block_order": [
                    "text_faq"
                  ]
                },
                "accordion_nYQYN0": {
                  "type": "_accordion",
                  "settings": {
                    "heading": "Comment savoir quand les remplacer ?"
                  },
                  "blocks": {
                    "text_faq": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Quand l'eau devient moins claire, que le débit ralentit, ou que le filtre change de couleur.</p>",
                        "text_style": "paragraph"
                      }
                    }
                  },
                  "block_order": [
                    "text_faq"
                  ]
                },
                "accordion_aLSuuP": {
                  "type": "_accordion",
                  "settings": {
                    "heading": "Les filtres remplacent-ils les capsules de soin ?"
                  },
                  "blocks": {
                    "text_faq": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Non. Le filtre retient les sédiments, la capsule apporte le soin et la senteur. Ils travaillent ensemble.</p>",
                        "text_style": "paragraph"
                      }
                    }
                  },
                  "block_order": [
                    "text_faq"
                  ]
                },
                "accordion_WJqZNv": {
                  "type": "_accordion",
                  "settings": {
                    "heading": "Puis-je les stocker longtemps ?"
                  },
                  "blocks": {
                    "text_faq": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Oui. Garde-les au sec, dans leur emballage d'origine, à température ambiante.</p>",
                        "text_style": "paragraph"
                      }
                    }
                  },
                  "block_order": [
                    "text_faq"
                  ]
                }
              },
