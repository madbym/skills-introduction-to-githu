                    "heading": "Combien de temps dure une capsule ?"
                  },
                  "blocks": {
                    "text_faq": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Selon ta fréquence de douche, quelques semaines. Quand la capsule est vide et transparente, remplace-la.</p>",
