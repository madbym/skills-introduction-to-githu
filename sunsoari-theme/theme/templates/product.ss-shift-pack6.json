                  "blocks": {
                    "text_faq": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Les capsules contiennent des huiles essentielles et s'utilisent diffusées dans l'eau de la douche. En cas de sensibilité connue aux parfums, consulte la liste INCI avant utilisation.</p>",
                        "text_style": "paragraph"
                      }
                    }
                  },
                  "block_order": [
                    "text_faq"
                  ]
                },
                "accordion_Tnr11B": {
                  "type": "_accordion",
                  "settings": {
                    "heading": "Avec quel pommeau sont-elles compatibles ?"
                  },
                  "blocks": {
                    "text_faq": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Uniquement avec le Pommeau de Douche Filtrant SHIFT, dont le compartiment est spécifique.</p>",
                        "text_style": "paragraph"
