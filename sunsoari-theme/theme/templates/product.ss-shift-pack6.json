                    "heading": "Puis-je alterner les collections ?"
                  },
                  "blocks": {
                    "text_faq": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Bien sûr ! Tu peux varier les senteurs selon tes envies et les saisons.</p>",
                        "text_style": "paragraph"
                      }
                    }
                  },
                  "block_order": [
                    "text_faq"
                  ]
                },
