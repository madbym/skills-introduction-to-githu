        "b2": {
          "type": "step",
          "settings": {
            "text": "<strong>Masse</strong> 2 à 3 pompes de mousse en mouvements circulaires, en évitant le contour des yeux."
          }
        },
        "b3": {
          "type": "step",
          "settings": {
            "text": "<strong>Rince</strong> à l'eau tiède et sèche en tamponnant."
