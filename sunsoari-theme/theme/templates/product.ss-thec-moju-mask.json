        "b2": {
          "type": "item",
          "settings": {
            "title": "Recette du Moju",
            "text": "<p>Riz fermenté, jujube, gingembre et cannelle, inspirés de la boisson traditionnelle de Jeonju.</p>",
            "tag": "",
            "link_label": "",
            "show_price": true
          }
        },
        "b3": {
          "type": "item",
          "settings": {
            "title": "Tissu microfibre",
