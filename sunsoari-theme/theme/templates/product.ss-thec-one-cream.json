          "type": "item",
          "settings": {
            "title": "Évaluée par la marque",
            "text": "<p>Selon les tests cliniques de THE C, amélioration de l'apparence des rides et de l'éclat après 2 et 4 semaines.</p>",
            "tag": "",
            "link_label": "",
            "show_price": true
