            "custom_liquid": "<div class=\"ss-pdp-facts\"><div><b>Pour qui</b>Tous types de peau, y compris sensibles</div><div><b>Format</b>Nomade 7 ml, idéal pour découvrir</div><div><b>Moment</b>Matin et soir, après le sérum</div></div>"
          }
