        },
        "b3": {
          "type": "item",
          "settings": {
            "title": "Format nomade",
            "text": "<p>7 ml pour tester la texture avant d'adopter, ou pour l'emporter partout.</p>",
            "tag": "",
            "link_label": "",
            "show_price": true
