      "settings": {
        "color_scheme": "scheme-1",
        "use_color_scheme_in_container": false,
        "enable_sticky_info": true,
        "media_size": "large",
        "gallery_layout": "vertical-carousel",
        "mobile_thumbnails": "show",
        "show_image_border": false,
        "enable_image_zoom": true,
        "enable_video_looping": true,
        "padding_top": 0,
        "padding_bottom": 40
      }
